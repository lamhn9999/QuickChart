@model LQ.Models.TableModels.Table;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style.css"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document
                .getElementById("signinbutton1")
                .addEventListener("click", signIn);
            document
                .getElementById("workspaceButton")
                .addEventListener("click", enterWorkspace);
        });
        
    </script>
</head>
<body>
<div style = "display: flex; gap: var(--main-div-gap);">
    <div style="width: 50vw">
        <header style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <div style="display:flex; gap:0; flex-direction:column; justify-content:center; align-items: center">
                <h1 class="glossy">WORKSPACE!(specific)</h1>
            </div>
        </header>
    </div>
</div>
</body>
</html>