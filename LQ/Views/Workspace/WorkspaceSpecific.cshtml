@using LQ.Models.DTOs
@using LQ.Models.TableModels
@model LQ.Models.DTOs.TableDisplayDTO;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
    <script src="/node_modules/chart.js/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-matrix@1.3.0"></script>
    <style>
        body { font-family: 'DM Sans', system-ui, sans-serif; }

        /* ── Drag-and-drop: header states ────────────────────────────────── */

        /* Grab cursor on every header cell */
        th[data-index] { cursor: grab; user-select: none; }
        th[data-index]:active { cursor: grabbing; }

        /* Pending (selected) — normal table view */
        th[data-index].header-pending > div {
            outline: 2px solid rgba(233,150,122,0.65);
            outline-offset: -2px;
            border-radius: 6px;
            background-color: rgba(233,150,122,0.05) !important;
        }
        /* Pending — collapsed card view */
        #mainWrapper.is-collapsed th[data-index].header-pending {
            border-color: rgba(233,150,122,0.55) !important;
            background-color: rgba(233,150,122,0.06) !important;
            box-shadow: 0 0 0 3px rgba(233,150,122,0.1) !important;
        }
        /* Header actively being dragged */
        th[data-index].header-dragging { opacity: 0.4; transition: opacity 0.12s ease; }

        /* ── Drop zone: empty panel ──────────────────────────────────────── */
        #plotPanel { background: #EFEFEF; }

        /* ── Drop zone: chart card ───────────────────────────────────────── */
        .grid-item-content.chart-drop-target {
            outline: 2px solid rgba(35,131,226,0.7);
            outline-offset: -2px;
            background: rgba(35,131,226,0.04);
        }
        .grid-item-content { transition: outline 0.12s ease, background 0.12s ease; }

        /* ── Document Canvas ─────────────────────────────────────────────── */
        #doc-canvas {
            display: flex;
            flex-direction: column;
            background: #fff;
            box-shadow:
                0 0 0 1px rgba(0,0,0,0.04),
                0 2px 8px rgba(0,0,0,0.04),
                0 12px 40px rgba(0,0,0,0.07);
            border-radius: 4px;
            margin: 1.5rem auto;
            padding: 3rem 4rem 8rem;
            max-width: 860px;
            width: calc(100% - 3rem);
            box-sizing: border-box;
        }

        /* Text blocks — feel like a word processor */
        .doc-text {
            font-family: 'DM Sans', sans-serif;
            font-size: 15px; line-height: 1.82; color: #18181B;
            caret-color: #18181B; outline: none;
            min-height: 1.82em; white-space: pre-wrap; word-break: break-word;
            padding: 3px 0;
        }
        .doc-text:empty::before {
            content: attr(data-placeholder);
            color: #C0C0CC; pointer-events: none; display: block;
        }

        /* Chart section */
        .doc-chart-section { margin: 2.5rem 0; }

        /* Drop cursor — orange insertion line that snaps between blocks during drag */
        .doc-drop-cursor {
            height: 2px;
            margin: 2px 0;
            background: #2383E2;
            border-radius: 2px;
            pointer-events: none;
            position: relative;
            flex-shrink: 0;
        }
        .doc-drop-cursor::before {
            content: '';
            position: absolute;
            left: -5px; top: -4px;
            width: 10px; height: 10px;
            border-radius: 50%;
            background: #2383E2;
        }

        /* Full-width charts (one per row) */
        .doc-chart-section .chartGrid { --grid-cols: 1 !important; }
    </style>
    <script type="module" src="~/js/main.js"></script>
</head>
<body class="bg-[#FAFAFA] text-[#18181B]">
<div class="flex flex-col h-screen max-h-screen">
    <nav class="bg-white/85 border-b border-zinc-100 backdrop-blur-md px-6 py-3.5 flex justify-between items-center sticky top-0 z-50 shadow-sm">
        <a href="/" class="flex items-center gap-2 no-underline hover:opacity-80 transition-opacity" style="font-family:'Syne',sans-serif">
            <img src="/01384a5a5e3c1ea5887b428641e12121.gif" alt="" style="width:18px;height:auto;">
            <span class="text-[0.95rem] font-bold tracking-tight text-[#18181B]">ACPTDA<span class="text-[#E9967A]">.</span></span>
        </a>
        <div class="flex items-center gap-4">
            @if (ViewBag.Username != null)
            {
                <span class="text-[0.82rem] font-medium text-zinc-400 pr-4 border-r border-zinc-200">
                    Hello, <span class="text-[#E9967A] font-semibold">@ViewBag.Username</span>
                </span>
            }
            <button id="signoutbutton"
                    class="hover:cursor-pointer flex items-center gap-1.5 text-[0.82rem] font-medium text-zinc-400 hover:text-[#18181B] bg-transparent border-none transition-colors px-2 py-1.5 rounded-lg hover:bg-zinc-50">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Back to Home
            </button>
        </div>
    </nav>
    <script>
        document.getElementById("signoutbutton").addEventListener("click", () => {
            window.location.href = "@Url.Action("Show","Home")";
        });
    </script>

    <div id="mainWrapper" class="group flex flex-1 flex-col md:flex-row min-h-0 md:max-h-full relative">
        
        <!-- Floating Expand/Collapse Button (Now handles the animation timing perfectly) -->
        <button
            onclick="const tp = document.getElementById('tablePanel'); tp.style.transition = 'all 0.5s ease-in-out'; document.getElementById('mainWrapper').classList.toggle('is-collapsed'); setTimeout(() => tp.style.transition = '', 500);"
            class="absolute bottom-6 left-6 z-[60] flex items-center justify-center w-12 h-12 bg-white hover:bg-zinc-50 text-zinc-500 hover:text-[#18181B] rounded-full border border-zinc-200 shadow-lg transition-all hover:scale-105 active:scale-95 cursor-pointer"
            title="Toggle Table"
        >
            <svg class="w-6 h-6 transition-transform duration-500 group-[.is-collapsed]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 3v18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>

        <!-- Table Panel (Removed transition classes so dragging is 100% instant) -->
        <div
            id="tablePanel"
            class="overflow-auto w-full md:w-1/2 md:min-w-1/5 group-[.is-collapsed]:md:!w-80 group-[.is-collapsed]:md:!min-w-[20rem] group-[.is-collapsed]:md:!max-w-[20rem] group-[.is-collapsed]:md:!flex-none relative z-20">
            
            <table id="dataTable" class="w-full border-separate border-spacing-0 group-[.is-collapsed]:block">
                <thead class="sticky top-0 shadow-[0_2px_8px_0_rgba(0,0,0,0.06)] group-[.is-collapsed]:block group-[.is-collapsed]:static group-[.is-collapsed]:shadow-none">
                <!-- The TR becomes the bordered column container when collapsed -->
                <tr class="group-[.is-collapsed]:flex group-[.is-collapsed]:flex-col group-[.is-collapsed]:items-stretch group-[.is-collapsed]:w-[calc(100%-2rem)] group-[.is-collapsed]:border group-[.is-collapsed]:border-zinc-100 group-[.is-collapsed]:rounded-2xl group-[.is-collapsed]:p-2 group-[.is-collapsed]:gap-1.5 group-[.is-collapsed]:m-4 group-[.is-collapsed]:bg-zinc-50/70 group-[.is-collapsed]:shadow-sm transition-all">
                    @{
                        foreach (var f in Model.Fields)
                        {
                            <!-- The TH becomes a larger, block-level card when collapsed -->
                            <th onclick="fieldClicked(@f.Index)" draggable="true" ondragstart="headerDragStart(event, @f.Index)" ondragend="headerDragEnd(event)" class="relative align-top p-2 bg-[#FAFAFA] border-b border-b-zinc-200 border-r border-r-zinc-200 last:border-r-0 has-[.gearPopup:not(.hidden)]:z-[100] group-[.is-collapsed]:flex group-[.is-collapsed]:flex-col group-[.is-collapsed]:w-full group-[.is-collapsed]:box-border group-[.is-collapsed]:text-left group-[.is-collapsed]:p-3 group-[.is-collapsed]:bg-white group-[.is-collapsed]:border group-[.is-collapsed]:border-zinc-100 group-[.is-collapsed]:rounded-xl group-[.is-collapsed]:hover:border-[#E9967A]/40 group-[.is-collapsed]:hover:bg-[#E9967A]/[0.03] transition-colors" data-index="@f.Index">
                                <div class="flex flex-col w-full">
                                    @{
                                        string typeSvg = f.TypeName switch {
                                            "Int32"    => """<line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/>""",
                                            "Double"   => """<line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/><circle cx="19" cy="19" r="1.5" fill="currentColor" stroke="none"/>""",
                                            "DateTime" => """<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>""",
                                            "Boolean"  => """<rect x="1" y="7" width="22" height="10" rx="5"/><circle cx="16" cy="12" r="3" fill="currentColor" stroke="none"/>""",
                                            _ when f.TypeName.StartsWith("List") => """<line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/>""",
                                            _          => """<text x="12" y="19" text-anchor="middle" font-family="'Times New Roman', Times, serif" font-size="20" font-weight="bold" fill="currentColor" stroke="none">T</text>"""
                                        };
                                        string typeLabel = f.TypeName switch {
                                            "Int32" => "Integer", "Double" => "Float", "DateTime" => "DateTime",
                                            "Boolean" => "Boolean", "String" => "Text",
                                            _ when f.TypeName.StartsWith("List") => "List", _ => f.TypeName
                                        };
                                        string ctName = f.TypeName switch {
                                            "String" => "string", "Int32" => "int", "Double" => "double",
                                            "DateTime" => "datetime", "Boolean" => "bool",
                                            _ when f.TypeName.StartsWith("List") => "list", _ => ""
                                        };
                                        var allTypes = new string[] { "string", "int", "double", "datetime", "bool", "list" };
                                    }

                                    <!-- Zone 1: type icon · field name · gear · filter -->
                                    <div class="flex items-center gap-1.5 pb-1.5 mb-1.5 border-b border-zinc-200 group-[.is-collapsed]:gap-2 group-[.is-collapsed]:pb-2 group-[.is-collapsed]:mb-2 group-[.is-collapsed]:border-zinc-100">
                                        <span class="text-zinc-400 shrink-0 group-[.is-collapsed]:text-[#E9967A]/70" id="fieldType-@f.Index" title="@typeLabel">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(typeSvg)</svg>
                                        </span>
                                        <span class="field-name-span font-medium text-[11px] text-[#27272A] flex-1 truncate leading-none min-w-0 group-[.is-collapsed]:text-[13px] group-[.is-collapsed]:font-semibold group-[.is-collapsed]:text-zinc-700 group-[.is-collapsed]:leading-tight">@f.Name</span>
                                        <!-- Gear -->
                                        <div class="relative shrink-0">
                                            <button class="gear-btn hover:cursor-pointer text-zinc-400 hover:text-zinc-700 transition-colors relative z-40 focus:outline-none p-0.5 rounded group-[.is-collapsed]:p-1 group-[.is-collapsed]:rounded-md group-[.is-collapsed]:hover:bg-zinc-100" onclick="gearBtnClicked(event, this)">
                                                <svg class="w-3 h-3 transition-transform duration-500 group-[.is-collapsed]:w-3.5 group-[.is-collapsed]:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                                </svg>
                                            </button>
                                            <div class="hidden gearPopup fixed border border-zinc-200 bg-white/97 backdrop-blur-xl shadow-2xl rounded-xl p-1 z-[9999] text-left font-normal" onclick="event.stopPropagation()">
                                                <div class="relative">
                                                    <div class="type-menu-btn px-3 py-2 hover:bg-zinc-100 rounded-lg cursor-pointer text-sm text-[#27272A] font-medium transition-colors flex items-center justify-between gap-3" onclick="toggleFieldTypeMenu(this)">
                                                        Change Field Type
                                                        <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                                    </div>
                                                    <div class="hidden type-menu-popup absolute top-0 left-full ml-1 w-max min-w-[120px] bg-white/97 backdrop-blur-3xl border border-zinc-200 rounded-xl p-1 shadow-2xl flex flex-col gap-0.5 z-[9999]">
                                                        @foreach (var t in allTypes) { if (t != ctName) { <button onclick="changeFieldType(event, @f.Index, '@t')" class="text-left px-3 py-1.5 text-xs text-zinc-600 hover:text-[#18181B] hover:bg-zinc-100 rounded-lg transition-colors w-full tracking-wide">@t</button> } }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Filter -->
                                        <div class="relative z-50 shrink-0 focus-within:z-[101] has-[.filterPopup:not(.hidden)]:z-[101]">
                                            <button class="filter-btn hover:cursor-pointer relative z-40 text-zinc-400 hover:text-zinc-600 transition-colors p-0.5 rounded group-[.is-collapsed]:p-1 group-[.is-collapsed]:rounded-md group-[.is-collapsed]:hover:bg-zinc-100" onclick="filterClicked(event, this)">
                                                <span class="filter-chip hidden absolute -top-1 -left-1 bg-[#E9967A] text-black text-[9px] font-bold h-3.5 min-w-[14px] flex items-center justify-center rounded-full pointer-events-none z-10 px-0.5"></span>
                                                <svg width="13" height="13" viewBox="0 0 24 24"><path d="M3 5H21L14 13V19L10 21V13L3 5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                            @if (f.TypeName == "Int32" || f.TypeName == "Double")
                                            {
                                                <div class="hidden filterPopup w-64 bg-white border border-zinc-200 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="@(f.TypeName == "Int32" ? "Int" : "Double")" onclick="filterPopupClicked(event, this)">
                                                    <div class="flex flex-col gap-3">
                                                        <div>
                                                            <label class="block text-xs text-zinc-500 mb-1">Specific Values</label>
                                                            <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                            <input type="number" step="any" placeholder="Add specific number..." class="int-specific-input rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-50 border border-zinc-200 text-[#18181B] placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onkeydown="filterIntSpecificKey(event, this)" />
                                                        </div>
                                                        <div class="text-xs text-zinc-500 text-center uppercase tracking-widest font-semibold mt-1">OR</div>
                                                        <div>
                                                            <label class="block text-xs text-zinc-500 mb-1">Range</label>
                                                            <div class="flex items-center gap-2">
                                                                <input type="number" step="any" placeholder="Min" class="int-range-min rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-50 border border-zinc-200 text-[#18181B] placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onkeydown="filterIntRangeKey(event, this)" />
                                                                <span class="text-zinc-400 text-xs">to</span>
                                                                <input type="number" step="any" placeholder="Max" class="int-range-max rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-50 border border-zinc-200 text-[#18181B] placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onkeydown="filterIntRangeKey(event, this)" />
                                                            </div>
                                                            <button class="mt-2 text-xs w-full font-medium bg-zinc-100 hover:bg-zinc-200 text-zinc-600 hover:text-[#18181B] py-1.5 rounded transition" onclick="applyIntRangeFilter(event, this)">Apply Range</button>
                                                        </div>
                                                        <label class="flex items-center gap-1.5 mt-1 cursor-pointer text-xs text-zinc-500">
                                                            <input type="checkbox" name="IsNot" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-white border border-zinc-300 rounded-4xl checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="excludeIntCheckboxClicked(event, this)" />
                                                            Exclude results
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                            else if (f.TypeName == "DateTime")
                                            {
                                                <div class="hidden filterPopup w-64 bg-white border border-zinc-200 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="DateTime" onclick="filterPopupClicked(event, this)">
                                                    <div class="flex flex-col gap-3">
                                                        <div>
                                                            <label class="block text-xs text-zinc-500 mb-1">Date Range</label>
                                                            <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                            <div class="flex flex-col gap-2">
                                                                <input type="datetime-local" placeholder="Min Date" class="dt-range-min rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-50 border border-zinc-200 text-[#18181B] placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" />
                                                                <span class="text-zinc-500 text-xs text-center">to</span>
                                                                <input type="datetime-local" placeholder="Max Date" class="dt-range-max rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-50 border border-zinc-200 text-[#18181B] placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" />
                                                            </div>
                                                            <button class="mt-2 text-xs w-full font-medium bg-zinc-100 hover:bg-zinc-200 text-zinc-600 hover:text-[#18181B] py-1.5 rounded transition" onclick="applyDtRangeFilter(event, this)">Apply Range</button>
                                                        </div>
                                                        <label class="flex items-center gap-1.5 mt-1 cursor-pointer text-xs text-zinc-500">
                                                            <input type="checkbox" name="IsNot" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-white border border-zinc-300 rounded-4xl checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="excludeDtCheckboxClicked(event, this)" />
                                                            Exclude results
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                            else if (f.TypeName == "Boolean")
                                            {
                                                <div class="hidden filterPopup w-56 bg-white border border-zinc-200 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="Bool" onclick="filterPopupClicked(event, this)">
                                                    <label class="block text-xs text-zinc-500 mb-2">Filter @f.Name</label>
                                                    <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                    <div class="flex gap-2 mb-2">
                                                        <button class="flex-1 text-xs font-medium bg-zinc-100 hover:bg-zinc-200 text-zinc-600 py-1.5 rounded transition" onclick="applyBoolFilter(event, this, 'true')">True</button>
                                                        <button class="flex-1 text-xs font-medium bg-zinc-100 hover:bg-zinc-200 text-zinc-600 py-1.5 rounded transition" onclick="applyBoolFilter(event, this, 'false')">False</button>
                                                    </div>
                                                </div>
                                            }
                                            else if (f.TypeName.StartsWith("List"))
                                            {
                                                <div class="hidden filterPopup w-56 bg-white border border-zinc-200 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="ListString" onclick="filterPopupClicked(event, this)">
                                                    <label class="block text-xs text-zinc-500 mb-1">Search items in @f.Name</label>
                                                    <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                    <input type="text" placeholder="Type to filter..." onkeydown="filterInputKey(event, this)" class="rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-50 border border-zinc-200 text-[#18181B] placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-[#E9967A] transition" />
                                                    <label class="flex items-center gap-1.5 mt-3 cursor-pointer text-xs text-zinc-600">
                                                        <input type="checkbox" name="IsPartialMatch" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-white border border-zinc-300 rounded-sm checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="partialMatchStrCheckboxClicked(event, this)" />
                                                        Must contain ANY (default ALL)
                                                    </label>
                                                    <label class="flex items-center gap-1.5 mt-2 cursor-pointer text-xs text-zinc-500">
