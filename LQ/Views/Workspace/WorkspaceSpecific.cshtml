                                                        <input type="checkbox" name="IsNot" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-white border border-zinc-300 rounded-4xl checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="excludeCheckboxClicked(event, this)" />
                                                        Exclude results
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Zone 3: field visual -->
                                    <div class="mt-1.5 group-[.is-collapsed]:mt-2.5 group-[.is-collapsed]:min-h-[48px]" data-spark-col="@f.Index" data-spark-type="@f.TypeName" data-spark-categorical="@(f.Categories.Contains(Category.Categorical).ToString().ToLower())">
                                        <canvas class="sparkline-canvas w-full block" style="height:28px"></canvas>
                                        <div class="sparkline-stat text-[9px] text-zinc-400 mt-0.5 group-[.is-collapsed]:text-[10px] group-[.is-collapsed]:mt-1"></div>
                                    </div>
                                </div>
                            </th>
                        }
                    }
