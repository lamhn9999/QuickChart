@using LQ.Models.DTOs
@using LQ.Models.TableModels
@model LQ.Models.DTOs.TableDisplayDTO;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <script src="/node_modules/chart.js/dist/chart.umd.min.js"></script>
    <script src="/node_modules/muuri/dist/muuri.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-matrix@1.3.0"></script>
    <style>
        body { font-family: 'Playfair Display', serif; }
    </style>
    <script type="module" src="~/js/main.js"></script>
</head>
<body class="bg-zinc-950 text-white">
<div class="flex flex-col h-screen max-h-screen">
    <nav class="bg-zinc-900 border-b border-zinc-800 px-6 py-4 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-semibold tracking-tight text-white">
                Workspace: <span class="text-[#E9967A] italic">@Model.FileName</span>
            </h1>
        </div>
        <div class="flex items-center gap-4">
            <button id="back" class="hover:cursor-pointer text-sm font-medium text-zinc-400 hover:text-white transition-colors flex items-center gap-2" onclick="backHome();">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Back to Home
            </button>
        </div>
    </nav>

    <div id="mainWrapper" class="group flex flex-1 flex-col md:flex-row min-h-0 md:max-h-full relative">
        
        <!-- Floating Expand/Collapse Button (Now handles the animation timing perfectly) -->
        <button
            onclick="const tp = document.getElementById('tablePanel'); tp.style.transition = 'all 0.5s ease-in-out'; document.getElementById('mainWrapper').classList.toggle('is-collapsed'); setTimeout(() => tp.style.transition = '', 500);"
            class="absolute bottom-6 left-6 z-[60] flex items-center justify-center w-12 h-12 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white rounded-full border border-zinc-600 shadow-2xl transition-all hover:scale-105 active:scale-95 cursor-pointer"
            title="Toggle Table"
        >
            <svg class="w-6 h-6 transition-transform duration-500 group-[.is-collapsed]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 3v18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>

        <!-- Table Panel (Removed transition classes so dragging is 100% instant) -->
        <div
            id="tablePanel"
            class="overflow-auto w-full md:w-1/2 md:min-w-1/5 group-[.is-collapsed]:md:!w-80 group-[.is-collapsed]:md:!min-w-[20rem] group-[.is-collapsed]:md:!max-w-[20rem] group-[.is-collapsed]:md:!flex-none relative z-20">
            
            <table id="dataTable" class="w-full border-separate border-spacing-0 group-[.is-collapsed]:block">
                <thead class="sticky top-0 group-[.is-collapsed]:block group-[.is-collapsed]:static">
                <!-- The TR becomes the bordered column container when collapsed -->
                <tr class="group-[.is-collapsed]:flex group-[.is-collapsed]:flex-col group-[.is-collapsed]:items-stretch group-[.is-collapsed]:w-[calc(100%-2rem)] group-[.is-collapsed]:border group-[.is-collapsed]:border-zinc-700 group-[.is-collapsed]:rounded-2xl group-[.is-collapsed]:p-3 group-[.is-collapsed]:gap-2 group-[.is-collapsed]:m-4 group-[.is-collapsed]:bg-zinc-900/30 transition-all">
                    @{
                        foreach (var f in Model.Fields)
                        {
                            <!-- The TH becomes a larger, block-level card when collapsed -->
                            <th onclick="fieldClicked(@f.Index)" class="relative align-top p-2 bg-zinc-900/80 border-b border-b-zinc-800 border-r border-r-zinc-800/30 has-[.gearPopup:not(.hidden)]:z-[100] group-[.is-collapsed]:flex group-[.is-collapsed]:flex-col group-[.is-collapsed]:w-full group-[.is-collapsed]:box-border group-[.is-collapsed]:text-left group-[.is-collapsed]:text-lg group-[.is-collapsed]:p-3 group-[.is-collapsed]:bg-zinc-800/50 group-[.is-collapsed]:border group-[.is-collapsed]:border-zinc-700/50 transition-colors" data-index="@f.Index">
                                <div class="flex flex-col">
                                    @{
                                        string typeSvg = f.TypeName switch {
                                            "Int32"    => """<line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/>""",
                                            "Double"   => """<line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/><circle cx="19" cy="19" r="1.5" fill="currentColor" stroke="none"/>""",
                                            "DateTime" => """<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>""",
                                            "Boolean"  => """<rect x="1" y="7" width="22" height="10" rx="5"/><circle cx="16" cy="12" r="3" fill="currentColor" stroke="none"/>""",
                                            _ when f.TypeName.StartsWith("List") => """<line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/>""",
                                            _          => """<text x="12" y="19" text-anchor="middle" font-family="'Times New Roman', Times, serif" font-size="20" font-weight="bold" fill="currentColor" stroke="none">T</text>"""
                                        };
                                        string typeLabel = f.TypeName switch {
                                            "Int32" => "Integer", "Double" => "Float", "DateTime" => "DateTime",
                                            "Boolean" => "Boolean", "String" => "Text",
                                            _ when f.TypeName.StartsWith("List") => "List", _ => f.TypeName
                                        };
                                        string ctName = f.TypeName switch {
                                            "String" => "string", "Int32" => "int", "Double" => "double",
                                            "DateTime" => "datetime", "Boolean" => "bool",
                                            _ when f.TypeName.StartsWith("List") => "list", _ => ""
                                        };
                                        var allTypes = new string[] { "string", "int", "double", "datetime", "bool", "list" };
                                    }

                                    <!-- Zone 1: type icon · field name · gear · filter -->
                                    <div class="flex items-center gap-1.5 pb-1.5 mb-1.5 border-b border-zinc-800/40">
                                        <span class="text-zinc-500 shrink-0" id="fieldType-@f.Index" title="@typeLabel">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(typeSvg)</svg>
                                        </span>
                                        <span class="font-medium text-[11px] text-zinc-200 flex-1 truncate leading-none min-w-0">@f.Name</span>
                                        <!-- Gear -->
                                        <div class="relative shrink-0">
                                            <button class="gear-btn hover:cursor-pointer text-zinc-600 hover:text-zinc-300 transition-colors relative z-40 focus:outline-none p-0.5 rounded" onclick="gearBtnClicked(event, this)">
                                                <svg class="w-3 h-3 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                                </svg>
                                            </button>
                                            <div class="hidden gearPopup fixed border border-white/20 bg-zinc-900/90 backdrop-blur-xl shadow-2xl rounded-xl p-1 z-[9999] text-left font-normal" onclick="event.stopPropagation()">
                                                <div class="relative">
                                                    <div class="type-menu-btn px-3 py-2 hover:bg-white/10 rounded-lg cursor-pointer text-sm text-zinc-100 font-medium transition-colors flex items-center justify-between gap-3" onclick="toggleFieldTypeMenu(this)">
                                                        Change Field Type
                                                        <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                                    </div>
                                                    <div class="hidden type-menu-popup absolute top-0 left-full ml-1 w-max min-w-[120px] bg-zinc-900/95 backdrop-blur-3xl border border-white/20 rounded-xl p-1 shadow-2xl flex flex-col gap-0.5 z-[9999]">
                                                        @foreach (var t in allTypes) { if (t != ctName) { <button onclick="changeFieldType(event, @f.Index, '@t')" class="text-left px-3 py-1.5 text-xs text-zinc-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors w-full tracking-wide">@t</button> } }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Filter -->
                                        <div class="relative z-50 shrink-0 focus-within:z-[101] has-[.filterPopup:not(.hidden)]:z-[101]">
                                            <button class="filter-btn hover:cursor-pointer relative z-40 text-zinc-600 hover:text-zinc-300 transition-colors p-0.5 rounded" onclick="filterClicked(event, this)">
                                                <span class="filter-chip hidden absolute -top-1 -left-1 bg-[#E9967A] text-black text-[9px] font-bold h-3.5 min-w-[14px] flex items-center justify-center rounded-full pointer-events-none z-10 px-0.5"></span>
                                                <svg width="13" height="13" viewBox="0 0 24 24"><path d="M3 5H21L14 13V19L10 21V13L3 5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                            @if (f.TypeName == "Int32" || f.TypeName == "Double")
                                            {
                                                <div class="hidden filterPopup w-64 bg-zinc-900 border border-zinc-800 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="@(f.TypeName == "Int32" ? "Int" : "Double")" onclick="filterPopupClicked(event, this)">
                                                    <div class="flex flex-col gap-3">
                                                        <div>
                                                            <label class="block text-xs text-zinc-400 mb-1">Specific Values</label>
                                                            <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                            <input type="number" step="any" placeholder="Add specific number..." class="int-specific-input rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onkeydown="filterIntSpecificKey(event, this)" />
                                                        </div>
                                                        <div class="text-xs text-zinc-500 text-center uppercase tracking-widest font-semibold mt-1">OR</div>
                                                        <div>
                                                            <label class="block text-xs text-zinc-400 mb-1">Range</label>
                                                            <div class="flex items-center gap-2">
                                                                <input type="number" step="any" placeholder="Min" class="int-range-min rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onkeydown="filterIntRangeKey(event, this)" />
                                                                <span class="text-zinc-500 text-xs">to</span>
                                                                <input type="number" step="any" placeholder="Max" class="int-range-max rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onkeydown="filterIntRangeKey(event, this)" />
                                                            </div>
                                                            <button class="mt-2 text-xs w-full font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white py-1.5 rounded transition" onclick="applyIntRangeFilter(event, this)">Apply Range</button>
                                                        </div>
                                                        <label class="flex items-center gap-1.5 mt-1 cursor-pointer text-xs text-zinc-400">
                                                            <input type="checkbox" name="IsNot" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-zinc-800 border border-zinc-600 rounded-4xl checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="excludeIntCheckboxClicked(event, this)" />
                                                            Exclude results
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                            else if (f.TypeName == "DateTime")
                                            {
                                                <div class="hidden filterPopup w-64 bg-zinc-900 border border-zinc-800 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="DateTime" onclick="filterPopupClicked(event, this)">
                                                    <div class="flex flex-col gap-3">
                                                        <div>
                                                            <label class="block text-xs text-zinc-400 mb-1">Date Range</label>
                                                            <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                            <div class="flex flex-col gap-2">
                                                                <input type="datetime-local" placeholder="Min Date" class="dt-range-min rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" />
                                                                <span class="text-zinc-500 text-xs text-center">to</span>
                                                                <input type="datetime-local" placeholder="Max Date" class="dt-range-max rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-[#E9967A]" />
                                                            </div>
                                                            <button class="mt-2 text-xs w-full font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white py-1.5 rounded transition" onclick="applyDtRangeFilter(event, this)">Apply Range</button>
                                                        </div>
                                                        <label class="flex items-center gap-1.5 mt-1 cursor-pointer text-xs text-zinc-400">
                                                            <input type="checkbox" name="IsNot" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-zinc-800 border border-zinc-600 rounded-4xl checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="excludeDtCheckboxClicked(event, this)" />
                                                            Exclude results
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                            else if (f.TypeName == "Boolean")
                                            {
                                                <div class="hidden filterPopup w-56 bg-zinc-900 border border-zinc-800 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="Bool" onclick="filterPopupClicked(event, this)">
                                                    <label class="block text-xs text-zinc-400 mb-2">Filter @f.Name</label>
                                                    <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                    <div class="flex gap-2 mb-2">
                                                        <button class="flex-1 text-xs font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-200 py-1.5 rounded transition" onclick="applyBoolFilter(event, this, 'true')">True</button>
                                                        <button class="flex-1 text-xs font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-200 py-1.5 rounded transition" onclick="applyBoolFilter(event, this, 'false')">False</button>
                                                    </div>
                                                </div>
                                            }
                                            else if (f.TypeName.StartsWith("List"))
                                            {
                                                <div class="hidden filterPopup w-56 bg-zinc-900 border border-zinc-800 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="ListString" onclick="filterPopupClicked(event, this)">
                                                    <label class="block text-xs text-zinc-400 mb-1">Search items in @f.Name</label>
                                                    <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                    <input type="text" placeholder="Type to filter..." onkeydown="filterInputKey(event, this)" class="rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-[#E9967A] transition" />
                                                    <label class="flex items-center gap-1.5 mt-3 cursor-pointer text-xs text-zinc-300">
                                                        <input type="checkbox" name="IsPartialMatch" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-zinc-800 border border-zinc-600 rounded-sm checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="partialMatchStrCheckboxClicked(event, this)" />
                                                        Must contain ANY (default ALL)
                                                    </label>
                                                    <label class="flex items-center gap-1.5 mt-2 cursor-pointer text-xs text-zinc-400">
                                                        <input type="checkbox" name="IsNot" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-zinc-800 border border-zinc-600 rounded-4xl checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="excludeCheckboxClicked(event, this)" />
                                                        Exclude results
                                                    </label>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="hidden filterPopup w-56 bg-zinc-900 border border-zinc-800 rounded-lg shadow-2xl p-3 z-[9999] text-left font-normal" data-field-type="String" onclick="filterPopupClicked(event, this)">
                                                    <label class="block text-xs text-zinc-400 mb-1">Search in @f.Name</label>
                                                    <div class="filterValues flex flex-wrap gap-1 mb-2 w-full"></div>
                                                    <input type="text" placeholder="Type to filter..." onkeydown="filterInputKey(event, this)" class="rounded-sm w-full px-2 py-1.5 text-xs bg-zinc-800 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-[#E9967A] transition" />
                                                    <label class="flex items-center gap-1.5 mt-3 cursor-pointer text-xs text-zinc-300">
                                                        <input type="checkbox" name="IsPartialMatch" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-zinc-800 border border-zinc-600 rounded-sm checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="partialMatchStrCheckboxClicked(event, this)" />
                                                        Partial Match
                                                    </label>
                                                    <label class="flex items-center gap-1.5 mt-2 cursor-pointer text-xs text-zinc-400">
                                                        <input type="checkbox" name="IsNot" value="true" class="w-3 h-3 hover:cursor-pointer appearance-none bg-zinc-800 border border-zinc-600 rounded-4xl checked:bg-[#E9967A] checked:border-[#E9967A] focus:outline-none focus:ring-1 focus:ring-[#E9967A]" onclick="excludeCheckboxClicked(event, this)" />
                                                        Exclude results
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Zone 3: field visual -->
                                    <div class="mt-1.5" data-spark-col="@f.Index" data-spark-type="@f.TypeName" data-spark-categorical="@(f.Categories.Contains(Category.Categorical).ToString().ToLower())">
                                        <canvas class="sparkline-canvas w-full block" style="height:28px"></canvas>
                                        <div class="sparkline-stat text-[9px] text-zinc-500 mt-0.5"></div>
                                    </div>
                                </div>
                            </th>
                        }
                    }
                </tr>
                </thead>
                <!-- Hides the rows entirely when collapsed -->
                <tbody class="group-[.is-collapsed]:hidden">
                @foreach (var row in Model.Values)
                {
                    <tr class="even:bg-zinc-900/30 hover:bg-zinc-800/50 transition-colors duration-75 group/row cursor-default">
                        @for (int ci = 0; ci < row.Length; ci++)
                        {
                            var fieldType = Model.Fields[ci].TypeName;
                            var isNum     = fieldType is "Int32" or "Double";
                            var cellVal   = row[ci];
                            var isEmpty   = string.IsNullOrEmpty(cellVal);
                            var isZero    = isNum && (cellVal == "0" || cellVal == "0.0" || cellVal == "0.00");
                            <td class="px-3 py-2 text-xs border-b border-zinc-800/15 whitespace-nowrap max-w-[220px] overflow-hidden text-ellipsis transition-colors duration-75
                                       @(isNum ? "text-right tabular-nums" : "")
                                       @(isEmpty ? "text-zinc-700" : isZero ? "text-zinc-600 group-hover/row:text-zinc-400" : "text-zinc-400 group-hover/row:text-zinc-100")">@cellVal</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Drag Handle (Fades out when collapsed) -->
        <div
            id="drag"
            class="hidden md:block mx-1 w-1 rounded-full cursor-col-resize bg-gray-500 transition-opacity duration-500 group-[.is-collapsed]:opacity-0 group-[.is-collapsed]:pointer-events-none"
        ></div>
        <div class="flex flex-col flex-1 w-full md:min-w-1/5 min-h-0 md:max-h-full overflow-auto relative z-10" id="plotPanel">
            <div class="chartGrid" id = "chartGrid">
                @* MUURI CHART GRID *@
            </div>
            <div class="flex-1 border-2 border-gray-500 content-center" id="selPlot">
                <p class="p-10 text-3xl text-center text-gray-500">Please click a table header to select a column. We will generate appropriate plots based on your selection.</p>
            </div>
            <div hidden class="flex-1 border-2 border-gray-600 content-center" id="noPlot">
                <p class="p-10 text-3xl text-center text-gray-500">No chart generated.</p>
            </div>
            <div hidden class="flex-1 content-center" id="loader">
                <div class="loader">
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__ball"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    const box = document.getElementById("tablePanel");

    let isDragging = false;
    let startX, startY;
    let scrollLeft, scrollTop;

    box.addEventListener("mousedown", (e) => {
        isDragging = true;
        box.classList.add("grabbing");

        // CORRECT way to apply !important in JavaScript
        box.style.setProperty('transition', 'none', 'important');

        // Prevent text highlighting during drag (fixes 90% of drag lag)
        document.body.style.setProperty('user-select', 'none', 'important');

        startX = e.pageX;
        startY = e.pageY;

        scrollLeft = box.scrollLeft;
        scrollTop = box.scrollTop;
    });

    document.addEventListener("mouseup", () => {
        if (!isDragging) return;
        isDragging = false;
        box.classList.remove("grabbing");

        // Clean up styles when done dragging
        box.style.removeProperty('transition');
        document.body.style.removeProperty('user-select');
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;

        e.preventDefault();

        const dx = e.pageX - startX;
        const dy = e.pageY - startY;

        box.scrollLeft = scrollLeft - dx;
        box.scrollTop = scrollTop - dy;
    });
</script>

