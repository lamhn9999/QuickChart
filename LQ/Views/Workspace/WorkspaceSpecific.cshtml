<script>
// ── Header sparklines — server data, plain canvas (no Chart.js) ───────────────
(function () {
    // Salmon accent matching the UI's #E9967A
    const [SR, SG, SB] = [233, 150, 122];
    const ac = a => `rgba(${SR},${SG},${SB},${a})`;
    const fmtN = n => Math.abs(n) >= 1e9 ? (n/1e9).toFixed(1)+'B'
                    : Math.abs(n) >= 1e6 ? (n/1e6).toFixed(1)+'M'
                    : Math.abs(n) >= 1e3 ? (n/1e3).toFixed(1)+'k'
                    : Number.isInteger(n) ? String(n) : n.toPrecision(3);
    // Labels that convey no categorical meaning
    const NA_RE = /^(n\/a|null|none|\(empty\)|unknown|-|)$/i;

    function draw(canvas, statEl, sample) {
        const W = canvas.offsetWidth || 120;
        const H = canvas.offsetHeight || 28;
        canvas.width  = W;
        canvas.height = H;
        const ctx = canvas.getContext('2d');

        // ChartType: Pie=0 Bar=1 Line=2 Histogram=3 Scatter=4
        //            PolarArea=5 SideBar=6 Mixed=7 Matrix=8 MixedBar=9 Bubble=10
        const type   = sample.chartType;
        const labels = sample.x ?? [];
        const y0     = sample.y?.[0];
        if (!y0?.data?.length) return;

        const nums = y0.data.map(Number).filter(n => !isNaN(n));
        if (!nums.length) return;

        let stat = '';

        if (type === 0) {
            const PIE_COLORS = [
                'rgba(233,150,122,0.9)',
                'rgba(99,179,237,0.82)',
                'rgba(154,230,180,0.82)',
                'rgba(113,113,122,0.55)',
            ];

            const total = nums.reduce((a, b) => a + b, 0);
            if (!total) return;

            // Build the slice data: ≤3 → all slices; ≥4 → top 3 + Other
            let sliceData, sliceLabels;
            if (nums.length <= 3) {
                sliceData   = nums.slice();
                sliceLabels = labels.map(String);
            } else {
                const otherSum = nums.slice(3).reduce((a, b) => a + b, 0);
                sliceData   = [nums[0], nums[1], nums[2], otherSum];
                sliceLabels = [String(labels[0]), String(labels[1]), String(labels[2]), 'Other'];
            }

            // Hide original canvas/stat and inject [pie | legend] row
            canvas.style.display = 'none';
            if (statEl) statEl.style.display = 'none';

            const row = document.createElement('div');
            row.style.cssText = 'display:flex;gap:7px;align-items:center;margin-top:2px';

            // ── Pie canvas ──────────────────────────────────────────────────
            const SZ = 38;
            const pc  = document.createElement('canvas');
            pc.width  = SZ; pc.height = SZ;
            pc.style.cssText = `width:${SZ}px;height:${SZ}px;flex-shrink:0`;

            const pctx = pc.getContext('2d');
            const cx = SZ / 2, cy = SZ / 2, r = SZ / 2 - 0.5;
            const sliceTotal = sliceData.reduce((a, b) => a + b, 0);
            let angle = -Math.PI / 2;
            sliceData.forEach((v, i) => {
                const sweep = (v / sliceTotal) * Math.PI * 2;
                pctx.beginPath();
                pctx.moveTo(cx, cy);
                pctx.arc(cx, cy, r, angle, angle + sweep);
                pctx.closePath();
                pctx.fillStyle = PIE_COLORS[i];
                pctx.fill();
                angle += sweep;
            });

            // ── Legend ──────────────────────────────────────────────────────
            const legend = document.createElement('div');
            legend.style.cssText = 'display:flex;flex-direction:column;gap:2px;flex:1;min-width:0';
            sliceData.forEach((v, i) => {
                const pct = Math.round(v / total * 100);
                const lbl = (sliceLabels[i] || '(empty)').replace(/^"+|"+$/g, '').slice(0, 18);
                const item = document.createElement('div');
                item.style.cssText = 'display:flex;align-items:center;gap:3px;font-size:9px;color:#71717A;line-height:1.45';
                item.innerHTML =
                    `<span style="width:6px;height:6px;border-radius:1px;background:${PIE_COLORS[i]};flex-shrink:0;display:inline-block"></span>`
                  + `<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">${lbl}</span>`
                  + `<span style="flex-shrink:0;font-variant-numeric:tabular-nums">${pct}%</span>`;
                legend.appendChild(item);
            });

            row.appendChild(pc);
            row.appendChild(legend);
            // Remove any row injected earlier by initSparklines (DOM-based pass)
            canvas.parentElement.querySelectorAll('.spark-row').forEach(el => el.remove());
            canvas.parentElement.appendChild(row);
            return;

        } else if (type === 2) {
            // Line → mini area line showing trend
            const peak = Math.max(...nums), trough = Math.min(...nums);
            const range = peak - trough || 1;
            const n = nums.length;
            const toX = i => (i / (n - 1)) * W;
            const toY = v => H - 2 - ((v - trough) / range) * (H - 4);

            const grad = ctx.createLinearGradient(0, 0, 0, H);
            grad.addColorStop(0, ac(0.22));
            grad.addColorStop(1, ac(0.02));

            ctx.beginPath();
            ctx.moveTo(toX(0), H);
            nums.forEach((v, i) => ctx.lineTo(toX(i), toY(v)));
            ctx.lineTo(toX(n - 1), H);
            ctx.closePath();
            ctx.fillStyle = grad;
            ctx.fill();

            ctx.beginPath();
            nums.forEach((v, i) => i === 0 ? ctx.moveTo(toX(i), toY(v)) : ctx.lineTo(toX(i), toY(v)));
            ctx.strokeStyle = ac(0.8);
            ctx.lineWidth = 1.5;
            ctx.lineJoin = 'round';
            ctx.stroke();

            if (labels.length >= 2)
                stat = `${String(labels[0]).slice(0, 10)}  –  ${String(labels[labels.length - 1]).slice(0, 10)}`;

        } else if (type === 3) {
            // Histogram → bars with top-to-bottom gradient + range stat
            const peak = Math.max(...nums);
            if (!peak) return;

            const bw = W / nums.length;
            const grad = ctx.createLinearGradient(0, 0, 0, H);
            grad.addColorStop(0, ac(0.75));
            grad.addColorStop(1, ac(0.25));
            ctx.fillStyle = grad;

            for (let i = 0; i < nums.length; i++) {
                const bh = Math.max(1, (nums[i] / peak) * (H - 2));
                ctx.fillRect(i * bw + 0.5, H - bh - 1, Math.max(1, bw - 1.5), bh);
            }

            const first = String(labels[0] ?? ''), last = String(labels[labels.length - 1] ?? '');
            const lo = parseFloat(first.replace(/[\[\(]/, ''));
            const hi = parseFloat(last.split(',')[1]);
            if (!isNaN(lo) && !isNaN(hi)) stat = `${fmtN(lo)} – ${fmtN(hi)}`;

        } else {
            // Bar / SideBar / MixedBar → bars faded by height ratio (works well for sorted desc data)
            const peak = Math.max(...nums);
            if (!peak) return;

            const total = nums.reduce((a, b) => a + b, 0);
            const bw = W / nums.length;

            for (let i = 0; i < nums.length; i++) {
                const ratio = nums[i] / peak;
                const bh = Math.max(1, ratio * (H - 2));
                // Taller bars are more opaque — creates natural visual hierarchy
                const alpha = 0.15 + 0.65 * Math.pow(ratio, 0.5);
                ctx.fillStyle = ac(alpha);
                ctx.fillRect(i * bw + 0.5, H - bh - 1, Math.max(1, bw - 1), bh);
            }

            // Stat: date range for time series, top-category summary for categorical
            const firstLbl = String(labels[0] ?? '');
            if (/\d{4}/.test(firstLbl) && nums.length >= 4) {
                stat = `${firstLbl.slice(0, 10)}  –  ${String(labels[labels.length - 1] ?? '').slice(0, 10)}`;
            } else if (labels.length > 0) {
                // Skip N/A-class entries to find most meaningful category
                let topIdx = 0;
                for (let i = 0; i < labels.length; i++) {
                    if (!NA_RE.test(String(labels[i]).trim())) { topIdx = i; break; }
                }
                const topPct = Math.round(nums[topIdx] / total * 100);
                stat = `${String(labels[topIdx] ?? '').slice(0, 16)} · ${topPct}%  ·  ${nums.length} cat`;
            } else {
                stat = `${nums.length} values`;
            }
        }

        if (statEl) statEl.textContent = stat;
    }

    async function loadSparkline(container) {
        const idx = container.dataset.sparkCol;
        try {
            const res = await fetch(`/workspace/sparkline/${idx}`);
            if (!res.ok || res.status === 204) return;
            const sample = await res.json();
            const canvas = container.querySelector('.sparkline-canvas');
            const statEl = container.querySelector('.sparkline-stat');
            if (canvas) draw(canvas, statEl, sample);
        } catch {}
    }

    async function loadAll() {
        const containers = Array.from(document.querySelectorAll('[data-spark-col]'));
        const BATCH = 4;
        for (let i = 0; i < containers.length; i += BATCH)
            await Promise.allSettled(containers.slice(i, i + BATCH).map(loadSparkline));
    }

    if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', loadAll);
    else
        loadAll();
})();
</script>
