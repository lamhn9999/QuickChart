<script>
    const box = document.getElementById("tablePanel");

    let isDragging = false;
    let startX, startY;
    let scrollLeft, scrollTop;

    box.addEventListener("mousedown", (e) => {
        // Don't intercept mousedown on draggable header cells
        if (e.target.closest('th[data-index]')) return;
        isDragging = true;
        box.classList.add("grabbing");

        // CORRECT way to apply !important in JavaScript
        box.style.setProperty('transition', 'none', 'important');

        // Prevent text highlighting during drag (fixes 90% of drag lag)
        document.body.style.setProperty('user-select', 'none', 'important');

        startX = e.pageX;
        startY = e.pageY;

        scrollLeft = box.scrollLeft;
        scrollTop = box.scrollTop;
    });

    document.addEventListener("mouseup", () => {
        if (!isDragging) return;
        isDragging = false;
        box.classList.remove("grabbing");

        // Clean up styles when done dragging
        box.style.removeProperty('transition');
        document.body.style.removeProperty('user-select');
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;

        e.preventDefault();

        const dx = e.pageX - startX;
        const dy = e.pageY - startY;

        box.scrollLeft = scrollLeft - dx;
        box.scrollTop = scrollTop - dy;
    });
</script>

<script>
// ── Document: drag-cursor chart insertion ─────────────────────────────────────
(function () {
    const canvas = document.getElementById('doc-canvas');
    const panel  = document.getElementById('plotPanel');
    const cursor = document.getElementById('docDropCursor');
    if (!canvas || !panel || !cursor) return;

    function _blocks() {
        return Array.from(canvas.children).filter(el => el !== cursor);
    }

    function _placeCursor(mouseY) {
        const blocks = _blocks();
        let insertBefore = null;
        for (let i = 0; i < blocks.length; i++) {
            const r = blocks[i].getBoundingClientRect();
            if (mouseY < r.top + r.height / 2) { insertBefore = blocks[i]; break; }
        }
        if (insertBefore) canvas.insertBefore(cursor, insertBefore);
        else              canvas.appendChild(cursor);
        cursor.style.display = '';
    }

    canvas.addEventListener('dragover', function (e) {
        if (!e.dataTransfer.types.includes('application/json')) return;
        e.preventDefault();
        if (e.target.closest('.grid-item-content')) {
            cursor.style.display = 'none';
        } else {
            _placeCursor(e.clientY);
        }
    });

    canvas.addEventListener('dragleave', function (e) {
        if (!canvas.contains(e.relatedTarget)) cursor.style.display = 'none';
    });

    panel.addEventListener('drop', function (e) {
        if (e.target.closest && e.target.closest('.grid-item-content')) {
            cursor.style.display = 'none';
            return;
        }
        cursor.style.display = 'none';
    }, true); // capture phase — before main.js createChartGroup
})();
</script>

