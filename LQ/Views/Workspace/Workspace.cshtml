<script>
// ── Header sparklines ─────────────────────────────────────────────────────────
(function () {
    const [SR, SG, SB] = [233, 150, 122];
    const ac = a => `rgba(${SR},${SG},${SB},${a})`;
    const fmtN = n => Math.abs(n) >= 1e9 ? (n/1e9).toFixed(1)+'B'
                    : Math.abs(n) >= 1e6 ? (n/1e6).toFixed(1)+'M'
                    : Math.abs(n) >= 1e3 ? (n/1e3).toFixed(1)+'k'
                    : Number.isInteger(n) ? String(n) : n.toPrecision(3);
    const NA_RE = /^(n\/a|null|none|\(empty\)|unknown|-|)$/i;

    function draw(canvas, statEl, sample) {
        const W = canvas.offsetWidth || 120;
        const H = canvas.offsetHeight || 28;
        canvas.width  = W;
        canvas.height = H;
        const ctx = canvas.getContext('2d');
        const type   = sample.chartType;
        const labels = sample.x ?? [];
        const y0     = sample.y?.[0];
        if (!y0?.data?.length) return;
        const nums = y0.data.map(Number).filter(n => !isNaN(n));
        if (!nums.length) return;
        let stat = '';

        if (type === 0) {
            const PIE_COLORS = ['rgba(233,150,122,0.9)','rgba(99,179,237,0.82)','rgba(154,230,180,0.82)','rgba(113,113,122,0.55)'];
            const total = nums.reduce((a, b) => a + b, 0);
            if (!total) return;
            let sliceData, sliceLabels;
            if (nums.length <= 3) { sliceData = nums.slice(); sliceLabels = labels.map(String); }
            else { const otherSum = nums.slice(3).reduce((a, b) => a + b, 0); sliceData = [nums[0], nums[1], nums[2], otherSum]; sliceLabels = [String(labels[0]), String(labels[1]), String(labels[2]), 'Other']; }
            canvas.style.display = 'none';
            if (statEl) statEl.style.display = 'none';
            const row = document.createElement('div');
            row.style.cssText = 'display:flex;gap:7px;align-items:center;margin-top:2px';
            const SZ = 38;
            const pc = document.createElement('canvas');
            pc.width = SZ; pc.height = SZ;
            pc.style.cssText = `width:${SZ}px;height:${SZ}px;flex-shrink:0`;
            const pctx = pc.getContext('2d');
            const cx = SZ/2, cy = SZ/2, r = SZ/2 - 0.5;
            const sliceTotal = sliceData.reduce((a, b) => a + b, 0);
            let angle = -Math.PI / 2;
            sliceData.forEach((v, i) => { const sweep = (v/sliceTotal)*Math.PI*2; pctx.beginPath(); pctx.moveTo(cx, cy); pctx.arc(cx, cy, r, angle, angle+sweep); pctx.closePath(); pctx.fillStyle = PIE_COLORS[i]; pctx.fill(); angle += sweep; });
            const legend = document.createElement('div');
            legend.style.cssText = 'display:flex;flex-direction:column;gap:2px;flex:1;min-width:0';
            sliceData.forEach((v, i) => { const pct = Math.round(v/total*100); const lbl = (sliceLabels[i]||'(empty)').replace(/^"+|"+$/g,'').slice(0,18); const item = document.createElement('div'); item.style.cssText='display:flex;align-items:center;gap:3px;font-size:9px;color:#71717A;line-height:1.45'; item.innerHTML=`<span style="width:6px;height:6px;border-radius:1px;background:${PIE_COLORS[i]};flex-shrink:0;display:inline-block"></span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">${lbl}</span><span style="flex-shrink:0;font-variant-numeric:tabular-nums">${pct}%</span>`; legend.appendChild(item); });
            row.appendChild(pc); row.appendChild(legend);
            canvas.parentElement.querySelectorAll('.spark-row').forEach(el => el.remove());
            canvas.parentElement.appendChild(row);
            return;
        } else if (type === 2) {
            const peak = Math.max(...nums), trough = Math.min(...nums);
            const range = peak - trough || 1;
            const n = nums.length;
            const toX = i => (i/(n-1))*W;
            const toY = v => H-2-((v-trough)/range)*(H-4);
            const grad = ctx.createLinearGradient(0,0,0,H);
            grad.addColorStop(0, ac(0.22)); grad.addColorStop(1, ac(0.02));
            ctx.beginPath(); ctx.moveTo(toX(0), H);
            nums.forEach((v, i) => ctx.lineTo(toX(i), toY(v)));
            ctx.lineTo(toX(n-1), H); ctx.closePath();
            ctx.fillStyle = grad; ctx.fill();
            ctx.beginPath();
            nums.forEach((v, i) => i===0 ? ctx.moveTo(toX(i), toY(v)) : ctx.lineTo(toX(i), toY(v)));
            ctx.strokeStyle = ac(0.8); ctx.lineWidth = 1.5; ctx.lineJoin = 'round'; ctx.stroke();
            if (labels.length >= 2) stat = `${String(labels[0]).slice(0,10)}  –  ${String(labels[labels.length-1]).slice(0,10)}`;
        } else if (type === 3) {
            const peak = Math.max(...nums);
            if (!peak) return;
            const bw = W/nums.length;
            const grad = ctx.createLinearGradient(0,0,0,H);
            grad.addColorStop(0, ac(0.75)); grad.addColorStop(1, ac(0.25));
            ctx.fillStyle = grad;
            for (let i=0;i<nums.length;i++) { const bh=Math.max(1,(nums[i]/peak)*(H-2)); ctx.fillRect(i*bw+0.5,H-bh-1,Math.max(1,bw-1.5),bh); }
            const first=String(labels[0]??''), last=String(labels[labels.length-1]??'');
            const lo=parseFloat(first.replace(/[\[\(]/,'')), hi=parseFloat(last.split(',')[1]);
            if (!isNaN(lo)&&!isNaN(hi)) stat=`${fmtN(lo)} – ${fmtN(hi)}`;
        } else {
            canvas.parentElement.querySelectorAll('.spark-row').forEach(el => el.remove());
            canvas.style.display = '';
            const peak = Math.max(...nums);
            if (!peak) return;
            const total = nums.reduce((a,b)=>a+b,0);
            const bw = W/nums.length;
            for (let i=0;i<nums.length;i++) { const ratio=nums[i]/peak; const bh=Math.max(1,ratio*(H-2)); const alpha=0.15+0.65*Math.pow(ratio,0.5); ctx.fillStyle=ac(alpha); ctx.fillRect(i*bw+0.5,H-bh-1,Math.max(1,bw-1),bh); }
            const firstLbl=String(labels[0]??'');
            if (/\d{4}/.test(firstLbl)&&nums.length>=4) { stat=`${firstLbl.slice(0,10)}  –  ${String(labels[labels.length-1]??'').slice(0,10)}`; }
            else if (labels.length>0) { let topIdx=0; for(let i=0;i<labels.length;i++){if(!NA_RE.test(String(labels[i]).trim())){topIdx=i;break;}} const topPct=Math.round(nums[topIdx]/total*100); stat=`${String(labels[topIdx]??'').slice(0,16)} · ${topPct}%  ·  ${nums.length} cat`; }
            else { stat=`${nums.length} values`; }
        }
        if (statEl && type !== 3) {
            if (stat.includes('  –  ')) {
                const [left, right] = stat.split('  –  ');
                statEl.style.cssText = 'display:flex;justify-content:space-between;width:100%';
                statEl.innerHTML = `<span>${left}</span><span>${right}</span>`;
            } else {
                statEl.style.cssText = '';
                statEl.textContent = stat;
            }
        }
    }

    async function loadSparkline(container) {
        const idx = container.dataset.sparkCol;
        if (container.dataset.sparkType === 'Boolean') return;
        try {
            const res = await fetch(`/workspace/sparkline/${idx}`);
            if (!res.ok || res.status === 204) return;
            const sample = await res.json();
            const canvas = container.querySelector('.sparkline-canvas');
            const statEl = container.querySelector('.sparkline-stat');
            if (canvas) {
                canvas.style.display = '';
                draw(canvas, statEl, sample);
            }
        } catch {}
    }

    async function loadAll() {
        const containers = Array.from(document.querySelectorAll('[data-spark-col]'));
        const BATCH = 4;
        const sparklinesReady = (async () => {
            for (let i=0; i<containers.length; i+=BATCH)
                await Promise.allSettled(containers.slice(i, i+BATCH).map(loadSparkline));
        })();

        await Promise.race([sparklinesReady, new Promise(r => setTimeout(r, 1750))]);

        const tp = document.getElementById('tablePanel');
        const mw = document.getElementById('mainWrapper');
        if (tp && mw && !mw.classList.contains('is-collapsed')) {
            tp.style.transition = 'all 0.5s ease-in-out';
            mw.classList.add('is-collapsed');
            setTimeout(() => { tp.style.transition = ''; }, 500);
        }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadAll);
    else loadAll();
})();
</script>

<div id="listConfirmOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);z-index:300;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:12px;max-width:520px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.2);padding:24px;font-family:'DM Sans',sans-serif;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <span style="font-weight:700;font-size:15px;">Some columns look like lists</span>
            <button onclick="dismissListConfirm()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#6b7280;line-height:1;">&times;</button>
        </div>
        <p style="font-size:13px;color:#6b7280;margin:0 0 14px;">Check the columns you want to treat as lists. Leave unchecked to keep as plain text.</p>
        <div id="listConfirmBody"></div>
        <div style="display:flex;gap:8px;margin-top:20px;justify-content:flex-end;">
            <button onclick="dismissListConfirm()" style="padding:7px 14px;border:1px solid #d1d5db;border-radius:6px;background:#fff;cursor:pointer;font-size:13px;">Treat all as text</button>
            <button onclick="submitListConfirm()" style="padding:7px 16px;border:none;border-radius:6px;background:#111827;color:#fff;cursor:pointer;font-size:13px;font-weight:600;">Apply choices</button>
        </div>
    </div>
</div>

<script>
    let _lcToken = null, _lcSuspicious = [];

    function showListConfirm(token, suspicious) {
        _lcToken = token;
        _lcSuspicious = suspicious;
        document.getElementById('listConfirmBody').innerHTML = suspicious.map((f, i) => `
            <div style="margin-bottom:14px;border:1px solid #e5e7eb;border-radius:8px;padding:12px;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <b style="font-size:14px">${f.fieldName}</b>
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;">
                        <input type="checkbox" id="lc-${i}"> It's a list
                    </label>
                </div>
                <div style="font-size:12px;color:#6b7280;margin:4px 0;">
                    Detected separator: <code style="background:#f3f4f6;padding:1px 5px;border-radius:3px">${f.separator === ',' ? 'comma (,)' : f.separator}</code>
                </div>
                <div style="font-size:12px;color:#374151;margin-top:6px;line-height:1.8;">
                    First values: ${f.samples.map(s => `<code style="background:#f3f4f6;padding:1px 4px;border-radius:3px;display:inline-block;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${s.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</code>`).join(' ')}
                </div>
            </div>`).join('');
        document.getElementById('listConfirmOverlay').style.display = 'flex';
    }

    async function postListConfirm(confirmed) {
        if (!_lcToken) return;
        await fetch('/confirm-list-fields', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: _lcToken, confirmed })
        });
    }

    async function submitListConfirm() {
        const confirmed = _lcSuspicious
            .filter((_, i) => document.getElementById(`lc-${i}`)?.checked)
            .map(f => ({ fieldIndex: f.fieldIndex, separator: f.separator }));
        await postListConfirm(confirmed);
        location.reload();
    }

    async function dismissListConfirm() {
        await postListConfirm([]);
        location.reload();
    }
</script>

@if (ViewBag.AwaitingListConfirmation == true)
{
    <script>
        (function () {
            const _bootToken = "@ViewBag.FileToken";
            const _bootSuspicious = @Html.Raw(string.IsNullOrEmpty(ViewBag.SuspiciousJson as string) ? "[]" : ViewBag.SuspiciousJson);
            if (Array.isArray(_bootSuspicious) && _bootSuspicious.length > 0) {
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', () => showListConfirm(_bootToken, _bootSuspicious));
                } else {
                    showListConfirm(_bootToken, _bootSuspicious);
                }
            }
        })();
    </script>
}

</body>
</html>
