<script>
    const box = document.getElementById("tablePanel");

    let isDragging = false;
    let startX, startY;
    let scrollLeft, scrollTop;

    box.addEventListener("mousedown", (e) => {
        if (e.target.closest('th[data-index]')) return;
        isDragging = true;
        box.classList.add("grabbing");
        box.style.setProperty('transition', 'none', 'important');
        document.body.style.setProperty('user-select', 'none', 'important');
        startX = e.pageX;
        startY = e.pageY;
        scrollLeft = box.scrollLeft;
        scrollTop = box.scrollTop;
    });

    document.addEventListener("mouseup", () => {
        if (!isDragging) return;
        isDragging = false;
        box.classList.remove("grabbing");
        box.style.removeProperty('transition');
        document.body.style.removeProperty('user-select');
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const dx = e.pageX - startX;
        const dy = e.pageY - startY;
        box.scrollLeft = scrollLeft - dx;
        box.scrollTop = scrollTop - dy;
    });
</script>

<script>
// ── Canvas: prevent default drag-over behavior, show drop affordance ──────────
(function () {
    const panel = document.getElementById('plotPanel');
    if (!panel) return;
    // Suppress drop-onto-card propagation reaching the panel drop handler
    panel.addEventListener('dragover', function (e) {
        if (!e.dataTransfer.types.includes('application/json')) return;
        // Suppress only when hovering a card panel (handled by chart.js)
        if (e.target.closest('.canvas-card-panels')) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'none';
        }
    }, true); // capture phase
})();
</script>

