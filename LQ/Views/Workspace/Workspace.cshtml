@using LQ.Models.TableModels
@model LQ.Models.TableModels.Table;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <script src="/node_modules/chart.js/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-matrix@1.3.0"></script>
    <script>
        let chartInstances = [];
        const listIndexes = new Set();
        const chartArray = ['pie', 'bar', 'line', 'bar', 'scatter', 'polarArea', 'bar', 'mixed', 'matrix'];
        // pie, vertical bar, line, histogram, scatter, polarArea, horizontal bar, mixed, matrix
        let controller;

        function buildHeatmapData(xLabels, ySeries) {
            return ySeries.flatMap(row =>
                row.data.map((value, colIndex) => ({
                    x: xLabels[colIndex],
                    y: row.label,
                    v: value? value : 0,
                }))
            );
        }

        function buildMatrixDataset(sample) {
            const heatmapData = buildHeatmapData(sample.x, sample.y);

            const values = heatmapData.map(d => d.v);
            // const minVal = Math.min(...values);
            const minVal = 0;
            const maxVal = Math.max(...values);

            const xCount = new Set(heatmapData.map(d => d.x)).size;
            const yCount = new Set(heatmapData.map(d => d.y)).size;

            return [{
                type: 'matrix',
                label: sample.title ?? 'Heatmap',
                data: heatmapData,
                borderColor: '#fff',
                borderWidth: 1,

                backgroundColor(ctx) {
                    const v = ctx.raw.v;
                    const t = (v - minVal) / (maxVal - minVal || 1);
                    return `rgba(0,123,255,${t})`;
                },

                width({ chart }) {
                    const a = chart.chartArea;
                    return a ? (a.right - a.left) / xCount - 2 : 0;
                },

                height({ chart }) {
                    const a = chart.chartArea;
                    return a ? (a.bottom - a.top) / yCount - 2 : 0;
                }
            }];
        }

        async function autoChart()
        {
            if(listIndexes.size === 0)
            {
                loader.hidden = true;
                selPlot.hidden = false;
                noPlot.hidden = true;
                return;
            }
            selPlot.hidden = true;
            noPlot.hidden = true;
            loader.hidden = false;
            
            controller = new AbortController();
            try {
                const response = await fetch("@Url.Action("AutoChart", "Workspace")", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify([...listIndexes].map(Number)),
                    signal: controller.signal
                });
                const result = await response.json();

                chartInstances.forEach(c => c.destroy());
                chartInstances.length = 0;
                loader.hidden = true;

                result.forEach(sample => {
                    const ctx = document.createElement("canvas");
                    panel.appendChild(ctx);

                    const isMatrix = chartArray[sample.chartType] === 'matrix';
                    const isMixed = chartArray[sample.chartType] === 'mixed';

                    const datasets = isMatrix
                        ? buildMatrixDataset(sample)
                        : [
                            ...sample.y.map(ds => ({
                                ...(isMixed && {
                                    type: chartArray[ds.chartType]
                                }),
                                label: ds.label,
                                data: ds.data,
                                yAxisID: 'y',
                            }))
                        ];

                    if (!isMatrix && sample.z?.length > 0) {
                        datasets.push(
                            ...sample.z.map(ds => ({
                                ...(isMixed && {
                                    type: chartArray[ds.chartType]
                                }),
                                label: ds.label,
                                data: ds.data,
                                yAxisID: 'z',
                            }))
                        );
                    }

                    const cfg = {
                        ...(!isMixed && {
                            type: chartArray[sample.chartType]
                        }),
                        data: {
                            ...(isMatrix ? {} : { labels: sample.x }),
                            datasets,
                        },
                        options: {
                            responsive: true,
                            scales: isMatrix
                                ? {
                                    x: {
                                        type: 'category',
                                        labels: sample.x,
                                        offset: true
                                    },
                                    y: {
                                        type: 'category',
                                        labels: sample.y.map(r => r.label),
                                        offset: true
                                    }
                                }
                                : isMixed 
                                    ? {
                                        y: { position: 'left', stacked: true }
                                    }
                                    : {
                                        y: { position: 'left' }
                                    }
                                ,
                        }
                    };
                    console.log(cfg);

                    if (isMatrix) {
                        cfg.options.plugins = cfg.options.plugins || {};
                        cfg.options.plugins.tooltip = cfg.options.plugins.tooltip || {};
                        cfg.options.plugins.tooltip.callbacks =
                            cfg.options.plugins.tooltip.callbacks || {};

                        cfg.options.plugins.tooltip.callbacks.title = (items) => {
                            const d = items[0].raw;
                            return `${d.y} / ${d.x}`;
                        };

                        cfg.options.plugins.tooltip.callbacks.label = (ctx) => {
                            const d = ctx.raw;
                            return `Value: ${d.v}`;
                        };
                    }

                    if (!isMatrix && sample.z?.length > 0) {
                        cfg.options.scales.z = { position: 'right' };
                    }

                    if (sample.chartType === 6) {
                        cfg.options.indexAxis = 'y';
                    }

                    const chartInstance = new Chart(ctx, cfg);
                    chartInstances.push(chartInstance);
                });


                if(chartInstances.length === 0)
                {
                    console.log("No charts found.");
                    selPlot.hidden = true;
                    noPlot.hidden = false;
                }
            }
            catch (error) {
                console.log(error);
            }
        }
    </script>
</head>
<body class="bg-zinc-950 text-white">
<div class="flex flex-col h-screen max-h-screen">
    <header class="flex shrink-0">
        <p class = "text-4xl font-bold italic text-" style="color:darksalmon">@Model.CSVFile.Name</p>
    </header>

    <div class="flex flex-1 flex-col md:flex-row min-h-0 md:max-h-full">
        <div
            id="tablePanel"
            class="overflow-auto
                   w-full md:w-1/2 md:min-w-1/5">
            <table id="dataTable" class="w-full border-separate border-spacing-0">
                <thead class="sticky top-0">
                <tr>
                    @{
                        foreach (FieldValues fv in Model.Columns)
                        {
                            <th onclick="fieldClicked(@fv.Field.Index)">
                                @fv.Field.Name
                            </th>
                        }
                    }
                </tr>
                </thead>
                <tbody>
                @for(int i = 0; i < Model.RowCount; i++)
                {
                    // DELETE LATER
                    if (i > 200) break;
                    <tr>
                        @foreach (FieldValues fv in Model.Columns)
                        {
                            <td>@fv.Values[i].ValueString</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div
            id="drag"
            class="hidden md:block mx-1 w-1 rounded-full
                   cursor-col-resize bg-gray-500"
        ></div>
        <div class="flex flex-col flex-1 w-full md:min-w-1/5 min-h-0 md:max-h-full overflow-auto" id="plotPanel">
            <div class="flex-1 border-2 border-gray-500 content-center" id="selPlot">
                <p class="p-10 text-3xl text-center text-gray-500">Please click a table header to select a column. We will generate appropriate plots based on your selection.</p>
            </div>
            <div hidden class="flex-1 border-2 border-red-600 content-center" id="noPlot">
                <p class="p-10 text-3xl text-center text-red-500">ZERO ZERO</p>
            </div>
            <div hidden class="flex-1 content-center" id="loader">
                <div class="loader">
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__bar"></div>
                    <div class="loader__ball"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    const panel = document.getElementById("plotPanel");
    const selPlot = document.getElementById("selPlot");
    const noPlot = document.getElementById("noPlot");
    const loader = document.getElementById("loader");

    function fieldClicked(fieldindex)
    {
        if(controller) {
            controller.abort("New fetch!");
        }
        panel.querySelectorAll("canvas").forEach(c => c.remove());
        if(listIndexes.has(fieldindex)) listIndexes.delete(fieldindex);
        else listIndexes.add(fieldindex);
        console.log(listIndexes);
        autoChart();
    }
</script>
<script>
    const resizer = document.getElementById('drag');
    const left = document.getElementById('tablePanel');
    const table = document.getElementById("dataTable");

    table.addEventListener("click", e => {
        const th = e.target.closest("th");
        if (!th) return;

        const colIndex = th.cellIndex;

        table.querySelectorAll("tr").forEach(row => {
            const cell = row.children[colIndex];
            if (cell) {
                cell.classList.toggle("col-selected");
            }
        });
    });

    let startX = 0;
    let startWidth = 0;
    let isDragging = false;

    resizer.addEventListener('mousedown', e => {
        isDragging = true;

        startX = e.clientX;
        startWidth = left.getBoundingClientRect().width;

        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
    });

    document.addEventListener('mousemove', e => {
        if (!isDragging) return;

        const dx = e.clientX - startX;
        left.style.width = `${startWidth + dx}px`;
    });

    document.addEventListener('mouseup', () => {
        isDragging = false;
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
    });
</script>
</body>
</html>