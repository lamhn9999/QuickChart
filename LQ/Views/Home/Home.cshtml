@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document
                .getElementById("signinbutton1")
                .addEventListener("click", signIn);
            document
                .getElementById("workspaceButton")
                .addEventListener("click", enterWorkspace);
        });
        function enterWorkspace()
        {
            window.location.href = '/workspace';
        }
        async function signIn()
        {
            const yourname = document.getElementById("nameinput1").value;
            const response = await fetch("@Url.Action("SignIn", "Auth")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `aname=${encodeURIComponent(yourname)}`
            });
            console.log(response);
            const result = await response.json();
            if (result.redirect) {
                window.location.href = result.redirect;
            }
        }
        async function select(filename) {
            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded" 
                },
                body: `filename=${encodeURIComponent(filename)}`
            });
            
            const data = await response.json();
            const table = document.getElementById("dataTable");
            table.innerHTML = "";
            table.hidden = false;

            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.removeProperty('display');

            for (let i = 0; i < data.length && i <= 200; i++) {
                const row = data[i];

                const tr = (i === 0)
                    ? document.createElement("thead")
                    : document.createElement("tr");

                if (i === 0) {
                    tr.classList.add("sticky", "top-0", "z-10", "bg-white");
                }

                row.forEach(cell => {
                    const el = document.createElement(i === 0 ? "th" : "td");
                    el.textContent = cell;
                    tr.appendChild(el);
                });

                table.appendChild(tr);
            }
        }
    </script>
</head>
<body class="bg-zinc-800 text-white">
<div class="flex h-screen">
    <div class="flex flex-col h-screen w-1/7 max-w-1/7 min-w-0 bg-zinc-900 p-5">
        <div class="flex text-4xl glossy">
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
        </div>
        <div class="listelement text-xl font-bold" id="doc">
            <button>Documentation</button>
        </div>
        <div class="mb-5 max-w-full min-w-0 overflow-hidden">
            <p class="text-xl font-bold">Sample files</p>
            <div class="text-xl min-w-0">
                @{
                    int id = 0;
                    foreach (string file in Model)
                    {
                        <div class="listelement min-w-0" id="listelement@id" onclick="select('@file');">
                            <div class="listline"></div>
                            <div class="listfile overflow-hidden text-ellipsis">@file</div>
                        </div>
                        id++;
                    }
                }
            </div>
        </div>
        <div class="text-2xl flex flex-col mb-5">
            <button class="signinbutton font-extrabold" id="signinbutton1">SIGN IN</button>
            <input class="text-black bg-white placeholder:text-black font-extrabold" type="text" autocomplete="off" id="nameinput1"/>
        </div>
        <div class="flex flex-1"></div>
        <div class="flex text-4xl glossy">
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
        </div>
    </div>
    <div class="flex flex-1 flex-col h-screen p-5 min-w-0">
        <header class=" text-4xl mb-5 text-center font-extrabold">
            <p>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</p>
        </header>
        <div class="flex flex-col flex-1 text-4xl min-h-0">
            <div class="flex font-bold justify-between">
                <p class="italic">Preview</p>
                <button class="signinbutton font-extrabold" id="workspaceButton" style="display: none">Enter Workspace /></button>
            </div>
            <div class="min-w-0 min-h-0 overflow-auto border-solid border-gray-500 border-2 flex-1 content-center align-middle">
                <table class="text-lg border-separate border-spacing-0 bg-zinc-950" id="dataTable" hidden></table>
                <div id="noPreview" class="text-center">
                    <p class="text-gray-500 font-bold">No preview available</p>
                </div>
            </div>
        </div>
    </div>
    <div class="flex flex-col h-screen w-1/7 max-w-1/7 min-w-0 bg-zinc-900 p-5">
        <div class="flex text-4xl glossy">
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
        </div>
        <div class="flex flex-1 flex-col justify-center text-center text-4xl font-extrabold
            bg-clip-text text-transparent
            bg-linear-to-r from-amber-300 to-red-300">
            <p class="mb-5 text-shadow-lg">*</p>
            <p class="mb-5 text-shadow-lg">CUNG</p>
            <p class="mb-5 text-shadow-lg">CHÚC</p>
            <p class="mb-5 text-shadow-lg">TÂN</p>
            <p class="mb-5 text-shadow-lg">XUÂN</p>
            <p class="mb-5 text-shadow-lg">*</p>
        </div>
        <div class="flex text-4xl glossy">
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
            <button class="logo hover:cursor-pointer"></button>
            
        </div>
    </div>
</div>
</body>
</html>