@using LQ.Models.DTOs
@model List<LQ.Models.TableModels.CSVFile>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>Automatic CSV Plotting Tool for Data Analysts</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Playfair Display', serif; }
        .tab-active { border-bottom: 2px solid #E9967A; color: #E9967A; }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const signinBtn = document.getElementById("signinbutton1");
            signinBtn.addEventListener("click", signIn);
            
            document
                .getElementById("workspaceButton")
                .addEventListener("click", enterWorkspace);

            const registerBtn = document.getElementById("registerbutton1");
            registerBtn.addEventListener("click", register);
            
            // Tab switching logic
            document.getElementById("tab-signin").addEventListener("click", () => showGroup('signin'));
            document.getElementById("tab-register").addEventListener("click", () => showGroup('register'));
        });

        function showGroup(type) {
            const signinDiv = document.getElementById("signin-group");
            const registerDiv = document.getElementById("register-group");
            const tabSignin = document.getElementById("tab-signin");
            const tabRegister = document.getElementById("tab-register");

            if(type === 'signin') {
                registerDiv.classList.add("hidden");
                signinDiv.classList.remove("hidden");
                tabRegister.classList.remove("tab-active");
                tabSignin.classList.add("tab-active");
                document.getElementById("nameinput").focus();
            } else {
                signinDiv.classList.add("hidden");
                registerDiv.classList.remove("hidden");
                tabSignin.classList.remove("tab-active");
                tabRegister.classList.add("tab-active");
                document.getElementById("nameinputr").focus();
            }
        }
        
        function enterWorkspace()
        {
            window.location.href = '/workspace';
        }
        
        async function signIn()
        {
            const yourname = document.getElementById("nameinput").value;
            const yourpw = document.getElementById("pwinput").value;
            const response = await fetch("@Url.Action("SignIn", "Auth")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: new URLSearchParams({
                    aname: yourname,
                    apassword: yourpw,
                }),
            });
            console.log(response);
            const result = await response.json();
            if (result.redirect) {
                window.location.href = result.redirect;
            }
        }
        
        async function register()
        {
            document.querySelectorAll("#register-group .error-log").forEach(e => e.remove());

            document.querySelectorAll("#register-group input").forEach(input => {
                input.classList.remove("error-border", "shake");
                input._errorLog = null;
            });
            const data = {
                name : document.getElementById("nameinputr").value,
                email : document.getElementById("emailinputr").value,
                password : document.getElementById("pwinputr").value,
                confirmpassword : document.getElementById("pwconfirminputr").value,
            };
            const response = await fetch("@Url.Action("Register", "Auth")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(data),
            });
            const result = await response.json();
            if(result.redirect) {
                window.location.href = result.redirect;
            }
            else if(result.error)
            {
                handleRegisterError(result);
            }
            else throw new Error("Something went wrong");
        }

        function handleRegisterError(result)
        {
            const group = {
                name : document.getElementById("nameinputr"),
                email : document.getElementById("emailinputr"),
                password : document.getElementById("pwinputr"),
                confirmpassword : document.getElementById("pwconfirminputr"),
            };

            if(result.error !== "Requirements not met!" && result.error !== "Registration failed.")
                throw new Error("Something went wrong");

            const details = result.details || [];
            const has = msg => details.some(d => d.includes(msg));

            if(has("Username is required") || has("Username must be between"))
                shake_and_log(group.name, "Invalid username");

            if(has("Email is required") || has("Invalid email"))
                shake_and_log(group.email, "Invalid email");

            if(has("Passwords do not match"))
                shake_and_log(group.confirmpassword, "Passwords do not match");


            // ---- password rule checks ----
            const pwErrors = [];

            if(has("Password is required"))
                pwErrors.push("Password required");

            if(has("Passwords must be at least 8 characters"))
                pwErrors.push("At least 8 characters");

            if(has("Passwords must have at least one non alphanumeric"))
                pwErrors.push("1 special character");

            if(has("Passwords must have at least one lowercase"))
                pwErrors.push("1 lowercase letter");

            if(has("Passwords must have at least one uppercase"))
                pwErrors.push("1 uppercase letter");

            if(pwErrors.length > 0)
                shake_and_log(group.password, pwErrors.join(", "));
        }
        function shake_and_log(input, message)
        {
            input.classList.add("error-border", "shake");

            if (input._errorLog) {
                input._errorLog.remove();
            }

            const log = document.createElement("div");
            log.className = "error-log";
            log.textContent = message;

            input.insertAdjacentElement("beforebegin", log);

            // store reference
            input._errorLog = log;

            setTimeout(() => {
                input.classList.remove("shake");
            }, 500);
        }
        
        async function select(filename) {
            document.getElementById("previewFilename").textContent = " - " + filename;
            document.getElementById("dataTable").hidden = true;
            document.getElementById("loader").hidden = false;
            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.display = "none";

            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded" 
                },
                body: `filename=${encodeURIComponent(filename)}`
            });
            
            const data = await response.json();
            document.getElementById("loader").hidden = true;
            const table = document.getElementById("dataTable");
            table.innerHTML = "";
            table.hidden = false;

            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.removeProperty('display');

            for (let i = 0; i < data.length && i <= 200; i++) {
                const row = data[i];

                const tr = (i === 0)
                    ? document.createElement("thead")
                    : document.createElement("tr");

                if (i === 0) {
                    tr.classList.add("sticky", "top-0", "z-20", "bg-zinc-800");
                }

                row.forEach(cell => {
                    const el = document.createElement(i === 0 ? "th" : "td");
                    el.textContent = cell;
                    if(i===0) el.classList.add("px-2", "py-2", "border-b", "border-zinc-700", "text-left");
                    else el.classList.add("px-2", "py-1.5", "border-b", "border-zinc-800/50");
                    tr.appendChild(el);
                });

                table.appendChild(tr);
            }
        }
    </script>
</head>
<body class="text-slate-200 min-h-screen flex flex-col relative overflow-x-hidden">
<div class="bg-aurora"></div>

<nav class="bg-white/5 backdrop-blur-xl border-b border-white/10 px-8 py-4 flex justify-between items-center sticky top-0 z-50">
    <div class="flex items-center gap-3">
        <span>
            <img src="01384a5a5e3c1ea5887b428641e12121.gif" alt="gif" class="w-5 h-auto scale-x-[-1]">
        </span>
        <h1 class="text-xl font-semibold tracking-tight text-white">Automatic CSV Plotting Tool for <span class="text-[#E9967A]">Data Analysts</span></h1>
    </div>
    <div class="flex items-center gap-6 text-sm font-medium text-zinc-300">
        <a href="#" class="hover:text-white transition-colors flex items-center gap-2"><span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M2 3h6a4 4 0 0 1 4 4v14a4 4 0 0 0-4-4H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a4 4 0 0 1 4-4h6z"></path></svg></span>Documentation</a>
        <a href="#" class="hover:text-white transition-colors flex gap-2"><span><img src="github-142-svgrepo-com.svg" alt="github_svg" class="w-5"/></span>GitHub</a>
        <a href="#" class="hover:text-white transition-colors flex items-center gap-2"><span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg></span>Contact</a>
        <button class="bg-white/10 backdrop-blur-md border border-white/20 text-white rounded-full px-5 py-2 text-sm font-semibold hover:bg-white/20 transition-all shadow-lg ml-2">Try ACPTDA</button>
    </div>
</nav>


<main class="flex-1 w-full max-w-7xl mx-auto p-8 flex flex-col gap-6 justify-center relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center min-h-[60vh]">
        <div class="flex flex-col gap-6">
             <h2 class="text-5xl font-extrabold leading-tight text-white mb-4">Effortless <span class="text-[#E9967A] italic">Data Visualization</span> at Your Fingertips.</h2>
             <p class="text-zinc-200 text-lg mb-4">Upload your CSV files and instantly generate amazing plots. Sign in to explore and manage your private workspace.</p>
             
             <div class="bg-zinc-900/40 backdrop-blur-xl border border-white/10 rounded-xl w-full max-w-sm shadow-[0_8px_32px_rgba(0,0,0,0.3)] flex flex-col pt-2">
                 <div class="flex border-b border-white/10 text-sm font-bold text-zinc-400 mb-4 px-6 pt-2">
                     <button id="tab-signin" class="pb-2 mr-6 tab-active transition-colors hover:text-white hover:cursor-pointer">Sign In</button>
                 
                     <button id="tab-register" class="pb-2 transition-colors hover:text-white hover:cursor-pointer">Register</button>
                 </div>
                 
                 <div class="px-6 pb-6 w-full">
                     <div id="signin-group" class="flex flex-col gap-3">
                         <input class="w-full bg-black/40 text-white placeholder-zinc-400 rounded p-2.5 border border-white/10 outline-none focus:border-[#E9967A] text-sm backdrop-blur-md" type="text" id="nameinput" placeholder="Your Name or Email"/>
                         <input class="w-full bg-black/40 text-white placeholder-zinc-400 rounded p-2.5 border border-white/10 outline-none focus:border-[#E9967A] text-sm backdrop-blur-md" type="password" id="pwinput" placeholder="Password"/>
                         <button class="font-bold hover:cursor-pointer bg-[darksalmon] text-white rounded p-2.5 w-full mt-2 hover:bg-[#E9967A] transition-all" id="signinbutton1">SIGN IN</button>
                     </div>
                     <div id="register-group" class="hidden flex flex-col gap-3">
                         <input class="w-full bg-black/40 text-white placeholder-zinc-400 rounded p-2.5 border border-white/10 outline-none focus:border-[#E9967A] text-sm backdrop-blur-md" type="text" id="nameinputr" placeholder="Your name"/>
                         <input class="w-full bg-black/40 text-white placeholder-zinc-400 rounded p-2.5 border border-white/10 outline-none focus:border-[#E9967A] text-sm backdrop-blur-md" type="text" id="emailinputr" placeholder="Your Email"/>
                         <input class="w-full bg-black/40 text-white placeholder-zinc-400 rounded p-2.5 border border-white/10 outline-none focus:border-[#E9967A] text-sm backdrop-blur-md" type="password" id="pwinputr" placeholder="Password"/>
                         <input class="w-full bg-black/40 text-white placeholder-zinc-400 rounded p-2.5 border border-white/10 outline-none focus:border-[#E9967A] text-sm backdrop-blur-md" type="password" id="pwconfirminputr" placeholder="Confirm Password"/>
                         <button class="font-bold bg-[darksalmon] hover:cursor-pointer text-white rounded p-2.5 w-full mt-2 hover:bg-[#E9967A] transition-all" id="registerbutton1">REGISTER</button>
                     </div>
                 </div>
             </div>
        </div>

        <div class="flex flex-col h-[550px]">
            <div class="bg-zinc-900/40 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.3)] flex flex-col h-full">
                <!-- Preview Header -->
                <div class="bg-white/5 border-b border-white/10 p-4 flex justify-between items-center z-30">
                    <p class="font-semibold text-white">Preview<span id="previewFilename" class="text-[#E9967A] font-bold"></span></p>
                    <button class="hover:cursor-pointer text-xs font-bold bg-[#E9967A] text-white px-3 py-1.5 rounded hover:bg-[darksalmon]" id="workspaceButton" style="display: none">Enter Workspace</button>
                </div>
                <!-- Preview Body -->
                <div class="flex-1 bg-black/20 overflow-auto relative content-center rounded-b-xl p-1">
                    <table class="w-full text-sm border-separate border-spacing-0" id="dataTable" hidden></table>
                    <div id="noPreview" class="text-center absolute inset-0 flex items-center justify-center">
                        <p class="text-zinc-400 font-medium">Video demonstrations will play here</p>
                    </div>
                    <div hidden class="absolute inset-0 flex items-center justify-center bg-zinc-950/80 z-10" id="loader">
                        <div class="loader">
                            <div class="loader__bar"></div><div class="loader__bar"></div>
                            <div class="loader__bar"></div><div class="loader__bar"></div>
                            <div class="loader__bar"></div><div class="loader__ball"></div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</main>

</body>
</html>