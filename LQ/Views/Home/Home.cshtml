@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>eiesei'pi</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style.css"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document
                .getElementById("signinbutton1")
                .addEventListener("click", signIn);
        });
        async function signIn()
        {
            const yourname = document.getElementById("nameinput1").value;
            const response = await fetch("@Url.Action("SignIn", "Auth")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `aname=${encodeURIComponent(yourname)}`
            });
            console.log(response);
            const result = await response.json();
            if (result.redirect) {
                window.location.href = result.redirect;
            }
        }
        async function select(filename) {
            const response = await fetch("@Url.Action("EnterWorkspace","Home")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded" 
                },
                body: `filename=${encodeURIComponent(filename)}`
            });
            
            const data = await response.json();
            const table = document.getElementById("dataTable");
            table.innerHTML = "";
            table.setAttribute("border", "1");

            data.forEach((row, i) => {
                const tr = document.createElement("tr");
                row.forEach(cell => {
                    const el = document.createElement(i === 0 ? "th" : "td");
                    el.textContent = cell;
                    tr.appendChild(el);
                });
                table.appendChild(tr);
            });
        }
    </script>
</head>
<body>
<div style = "display: flex; gap: var(--main-div-gap);">
    <div style="width: 50vw">
        <header style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <div style="display:flex; gap:0; flex-direction:column; justify-content:center; align-items: center">
                <h1 class="glossy">THE WORLD'S NO.1 AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</h1>
            </div>
        </header>
        <h2 class="listlabel">Our service automatically visualizes data from CSV files. Try it out by selecting one of these sample CSVs.</h2>
        <div>
            @foreach (string file in Model)
            {
                <div class="listelement" onclick="select('@file');">
                    <div class="listline"></div>
                    <div class="listfile">@file</div>
                </div>
            }
        </div>
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h2>Or</h2>
            <button class="signinbutton" id="signinbutton1">Sign In</button>
            <input type="text" id="nameinput1"/>
            <h2>to</h2>
        </div>
        <div style="position: relative; width: fit-content">
            <div style="display:flex; align-items:center; gap: var(--main-div-gap); position: relative; z-index: 1">
                <h2 style="color: darkgrey">Upload a CSV</h2>
            </div>
            <div class="sealed">
                <div class="sealed-track">
                    <div class="sealed-segment">sealed sealed sealed sealed sealed sealed sealed sealed</div>
                    <div class="sealed-segment">sealed sealed sealed sealed sealed sealed sealed</div>
                </div>
            </div>
        </div>
    </div>
    <div style="width: 50vw; height: 90vh; overflow: auto">
        <table id="dataTable"></table>
    </div>
</div>
</body>
</html>