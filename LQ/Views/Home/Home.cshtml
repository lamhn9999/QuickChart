@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>LQ</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root {
            font-size: clamp(0.3em, 3vw + 1.5em, 3em);
            --main-margin: 0.875em;
            --main-div-gap: 0.75em;
            font-family: monospace;
            color: white;
            margin: 0;
            padding: 0;
        }
        h1, h2, h3 {
            margin: 0;
            padding: 0;
        }
        
        html {
            -webkit-text-size-adjust: 100%;
        }
        
        body {
            padding: 1em;
            background-color: black;
        }
        
        .listlabel {
        }
        .listlabel + div {
            margin-left: calc(2 * var(--main-margin));
        }
        
        .listelement {
            display: flex;
            min-height: 1rem;
            gap: 0;
        }
        .listfile {
        }
        .listconnectline {
            height: 1rem;
            border: 1px solid white;
            border-top: none;
            border-right: none;
            border-bottom: none;
        }
        .listline {
            border: 1px solid white;
            border-top-color: transparent;
            border-right-color: transparent;
            width: 1rem;
            margin-right: 1rem;
        }
        
        .listelement:hover {
            background-color: darksalmon;
            color: black;
            cursor: pointer;
        }

        .sealed {
            z-index: 10;
            position: absolute;
            top: 20px;
            background: transparent;
            width: 100%;
            overflow: hidden;
            display: flex;
            align-items: center;
            color: yellow;
            font-weight: 700;
            font-size: 1rem;
        }
        .sealed-track {
            display: flex;
            width: 200%;
            animation: sealed-scroll 6s linear infinite;
            will-change: transform;
        }
        .sealed-segment {
            display: flex;
            gap: 1rem;
            white-space: nowrap;
            align-items: center;
            padding-right: 2rem;
        }
        @@keyframes sealed-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .addbutton {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 1.25rem;   
            height: 1.25rem;
            border-radius: 50%;         
            border: 2px solid;   
            background: transparent;       
            font-size: 1.5rem;     
            cursor: pointer;
        }
        .addbutton::before {
            content: "+";
        }
        .addbutton:hover {
            border: 2px dashed darksalmon;
            color: darksalmon;
            animation: spin 4s infinite linear;
        }
        @@keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        .signinbutton{
            padding: 0;
            background: none;
            border: none;
            cursor: pointer;
            display: inline-block;
            font-size: 1.25rem;
            font-weight: bolder;
            color: darksalmon;
            text-shadow: -4px 4px 1px goldenrod, 4px -4px 1px green;
            animation: shuffle 0.5s infinite linear;
        }
        .signinbutton:hover {
            animation-play-state: paused;
        }
        .signinbutton:active {
            animation: none;
            text-shadow: 5px -5px 10px goldenrod, -5px 5px 10px green;
        }
        @@keyframes shuffle {
            0% { text-shadow: -4px 4px 1px goldenrod, 4px -4px 1px green; }
            50% { text-shadow: -4px 4px 1px green, 4px -4px 1px goldenrod; }
            100% { text-shadow: -4px 4px 1px goldenrod, 4px -4px 1px green; }
        }

        .glossy {
            font-weight: bold;
            font-family: "URW Gothic";
            color: transparent;
            -webkit-text-fill-color: transparent;
            background-image:
                linear-gradient(
                    120deg,
                    rgba(255,255,255,0)      20%,
                    rgba(255,255,255,0.05)   30%,
                    rgba(255,255,255,0.12)   36%,
                    rgba(255,255,255,0.20)   40%,
                    rgba(255,255,255,0.30)   44%,
                    rgba(255,255,255,0.45)   47%,
                    rgba(255,255,255,0.60)   50%,
                    rgba(255,255,255,0.45)   53%,
                    rgba(255,255,255,0.30)   56%,
                    rgba(255,255,255,0.20)   60%,
                    rgba(255,255,255,0.12)   64%,
                    rgba(255,255,255,0.05)   70%,
                    rgba(255,255,255,0)      80%
                ),
                linear-gradient(darksalmon, darksalmon);
            background-size: 250% 100%, 100% 100%;
            background-position: -250% 0, 0 0;
            background-clip: text;
            -webkit-background-clip: text;
            animation: shine 20s infinite linear;
        }

        @@keyframes shine {
            0% { background-position: -250% 0, 0 0; }
            100% { background-position: 250% 0, 0 0; }
        }
    </style>
</head>
<body>
<div style = "display: flex; gap: var(--main-div-gap);">
    <div style="width: 50vw">
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h1 class = "glossy">LQ</h1>
            <p style="width: 0; font-size: var(--main-div-gap)">Automatic CSV Plotter.</p>
        </div>
        <h2 class="listlabel">Select a CSV</h2>
        <div>
            @foreach (string file in Model)
            {
                <div class="listelement">
                    <div class="listline"></div>
                    <div class="listfile">@file</div>
                </div>
            }
        </div>
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h2>or</h2>
            <button class="signinbutton">Sign In</button>
            <h2>to</h2>
        </div>
        <div style="position: relative; width: fit-content">
            <div id="uploadacsv" style="display:flex; align-items:center; gap: var(--main-div-gap); position: relative; z-index: 1">
                <h2 style="color: darkgrey">Upload a CSV</h2>
                <button class="addbutton" style="color: darkgrey; border-color: darkgrey"></button>
                @* <button class="addbutton" onclick="document.getElementById('fileInput').click()"></button> *@
                <input type="file"
                       name="file"
                       accept=".csv"
                       id="fileInput"
                       style="display:none;"
                       onchange="uploadFile(Event)">
            </div>
            <div class="sealed">
                <div class="sealed-track">
                    <div class="sealed-segment">sealed sealed sealed sealed sealed sealed sealed sealed</div>
                    <div class="sealed-segment">sealed sealed sealed sealed sealed sealed sealed</div>
                </div>
            </div>
        </div>
        <script>
            async function uploadFile(event) {
                const file = event.target.files[0];
                if(!file) return;
                
                const fileName = file.name;
                const fileContent = await file.text();

                const response = await fetch("@Url.Action("Upload", "Home")", {
                    method: "POST",
                    body: JSON.stringify({
                        Name: fileName,
                        Content: fileContent
                    })
                });
                console.log(response);
            }
        </script>
    </div>
</div>
</body>
</html>