@model List<LQ.Models.TableModels.CSVFile>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <script>
        let signinInputs;
        let registerInputs;
        
        document.addEventListener("DOMContentLoaded", () => {
            const signinBtn = document.getElementById("signinbutton1");
            signinBtn.addEventListener("click", signIn);
            
            document
                .getElementById("workspaceButton")
                .addEventListener("click", enterWorkspace);

            const registerBtn = document.getElementById("registerbutton1");
            registerBtn.addEventListener("click", register);

            signinInputs = [
                document.getElementById("nameinput"),
                document.getElementById("pwinput")
            ];

            registerInputs = [
                document.getElementById("nameinputr"),
                document.getElementById("pwinputr"),
                document.getElementById("pwconfirminputr")
            ];
        });

        function showGroup(show, hide) {
            hide.forEach(i => i.classList.remove("show"));
            setTimeout(() => {
                show.forEach(i => i.classList.add("show"));
                show[0].focus();
            }, 200);
        }
        
        function enterWorkspace()
        {
            window.location.href = '/workspace';
        }
        
        async function signIn()
        {
            showGroup(signinInputs, registerInputs);
            const yourname = document.getElementById("nameinput").value;
            const yourpw = document.getElementById("pwinput").value;
            const response = await fetch("@Url.Action("SignIn", "Auth")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: new URLSearchParams({
                    aname: yourname,
                    apassword: yourpw,
                }),
            });
            console.log(response);
            const result = await response.json();
            if (result.redirect) {
                window.location.href = result.redirect;
            }
        }
        async function register()
        {
            showGroup(registerInputs, signinInputs);
        }
        
        async function select(filename) {
            document.getElementById("previewFilename").textContent = " - " + filename;
            document.getElementById("dataTable").hidden = true;
            document.getElementById("loader").hidden = false;
            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.display = "none";

            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded" 
                },
                body: `filename=${encodeURIComponent(filename)}`
            });
            
            const data = await response.json();
            document.getElementById("loader").hidden = true;
            const table = document.getElementById("dataTable");
            table.innerHTML = "";
            table.hidden = false;

            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.removeProperty('display');

            for (let i = 0; i < data.length && i <= 200; i++) {
                const row = data[i];

                const tr = (i === 0)
                    ? document.createElement("thead")
                    : document.createElement("tr");

                if (i === 0) {
                    tr.classList.add("sticky", "top-0", "z-50", "bg-white");
                }

                row.forEach(cell => {
                    const el = document.createElement(i === 0 ? "th" : "td");
                    el.textContent = cell;
                    tr.appendChild(el);
                });

                table.appendChild(tr);
            }
        }
    </script>
</head>
<body class="bg-zinc-800 text-white">
<div class="flex h-screen">
    <div class="flex flex-col h-screen min-w-0 p-4 border-r border-zinc-700" style="width: 15%; max-width: 200px;">
        <div class="listelement text-lg font-bold mb-2" id="doc">
            <button>Documentation</button>
        </div>
        <div class="mb-5 max-w-full min-w-0">
            <p class="text-lg font-bold">Sample files</p>
            <div class="text-base min-w-0">
                @{
                    int id = 0;
                    foreach (var file in Model)
                    {
                        <div class="flex justify-between">
                            <div class="listelement min-w-0" id="listelement@id" onclick="select('@file.Name');">
                                <div class="listline"></div>
                                <div class="listfile overflow-hidden text-ellipsis">@file.Name</div>
                            </div>
                        </div>
                        id++;
                    }
                }
            </div>
        </div>
        <div class="text-lg flex flex-col mb-4">
            <button class="signinbutton font-extrabold" id="signinbutton1">SIGN IN</button>
            <input class=" text-black bg-white placeholder:text-black font-bold p-1 mt-1 text-sm" type="text" id="nameinput"/>
            <input class=" text-black bg-white placeholder:text-black font-bold p-1 mt-1 text-sm" type="password" id="pwinput"/>
        </div>
        <div class="text-lg flex flex-col mb-4">
            <button class="registerbutton font-extrabold" id="registerbutton1">REGISTER</button>
            <input class=" text-black bg-white placeholder:text-black font-bold p-1 mt-1 text-sm" type="text" id="nameinputr"/>
            <input class=" text-black bg-white placeholder:text-black font-bold p-1 mt-1 text-sm" type="password" id="pwinputr"/>
            <input class=" text-black bg-white placeholder:text-black font-bold p-1 mt-1 text-sm" type="password" id="pwconfirminputr"/>
        </div>

        <div class="flex flex-1"></div>
    </div>
    <div class="flex flex-1 flex-col h-screen p-5 min-w-0">
        <div class="flex flex-col flex-1 text-4xl min-h-0">
            <div class="flex font-bold justify-between">
                <p class="italic">Preview<span id="previewFilename" style="color: darksalmon;"></span></p>
                <button class="enterbutton font-extrabold" id="workspaceButton" style="display: none">Enter Workspace /></button>
            </div>
            <div class="min-w-0 min-h-0 overflow-auto border-solid border-gray-500 border-2 flex-1 content-center align-middle">
                <table class="text-lg border-separate border-spacing-0 bg-zinc-950" id="dataTable" hidden></table>
                <div id="noPreview" class="text-center">
                    <p class="text-gray-500 font-bold">No preview available</p>
                </div>
                <div hidden class="flex-1 content-center" id="loader">
                    <div class="loader">
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__ball"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  
    
</div>
</body>
</html>