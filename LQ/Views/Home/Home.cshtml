@using LQ.Models.DTOs
@model List<LQ.Models.TableModels.CSVFile>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>ACPTDA — Automatic CSV Visualization for Data Analysts</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #FAFAFA;
            --bg-card: #FFFFFF;
            --text: #18181B;
            --text-muted: #71717A;
            --text-light: #A1A1AA;
            --accent: #E9967A;
            --accent-light: rgba(233,150,122,0.09);
            --accent-border: rgba(233,150,122,0.28);
            --accent-hover: #D4836A;
            --border: rgba(0,0,0,0.07);
            --shadow-card: 0 1px 4px rgba(0,0,0,0.05), 0 4px 20px rgba(0,0,0,0.06);
            --shadow-dark: 0 24px 64px rgba(0,0,0,0.20), 0 8px 24px rgba(0,0,0,0.12);
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            background-image: radial-gradient(rgba(0,0,0,0.05) 1px, transparent 0);
            background-size: 28px 28px;
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── STAR CANVAS ── */
        #starCanvas {
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none; z-index: 0;
        }

        /* ── NAV PILL ── */
        .nav-wrapper {
            position: fixed; top: 1.1rem; left: 50%;
            transform: translateX(-50%);
            z-index: 100; width: 100%; max-width: 920px; padding: 0 1.25rem;
        }
        .nav-pill {
            background: rgba(255,255,255,0.72);
            backdrop-filter: blur(20px) saturate(160%);
            -webkit-backdrop-filter: blur(20px) saturate(160%);
            border: 1px solid rgba(255,255,255,0.9);
            border-radius: 9999px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07), 0 1px 3px rgba(0,0,0,0.04),
                        inset 0 1px 0 rgba(255,255,255,0.85);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0.55rem 1.4rem;
        }
        .nav-logo {
            display: flex; align-items: center; gap: 0.45rem;
            font-family: 'Syne', sans-serif; font-weight: 700;
            font-size: 0.95rem; color: var(--text); text-decoration: none;
            letter-spacing: -0.02em;
        }
        .nav-logo .dot { color: var(--accent); }
        .nav-links { display: flex; align-items: center; gap: 1.6rem; }
        .nav-links a {
            font-size: 0.83rem; font-weight: 500; color: var(--text-muted);
            text-decoration: none; transition: color 0.18s;
            display: flex; align-items: center; gap: 5px;
        }
        .nav-links a:hover { color: var(--text); }
        .nav-cta {
            font-size: 0.83rem; font-weight: 600; color: var(--accent);
            background: transparent; border: 1.5px solid var(--accent-border);
            border-radius: 9999px; padding: 0.38rem 1.1rem;
            cursor: pointer; transition: all 0.18s; letter-spacing: 0.01em;
        }
        .nav-cta:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

        /* ── PAGE SHELL ── */
        .page { position: relative; z-index: 1; padding-top: 5.8rem; padding-bottom: 3rem; }

        /* ── HERO INTRO (centered, above the grid) ── */
        .hero-intro {
            max-width: 680px; margin: 0 auto;
            padding: 2.5rem 2rem 2rem;
            text-align: center;
            display: flex; flex-direction: column; align-items: center; gap: 1rem;
        }
        .badge {
            display: inline-flex; align-items: center; gap: 0.45rem;
            background: var(--accent-light); border: 1px solid var(--accent-border);
            border-radius: 9999px; padding: 0.32rem 0.9rem;
            font-size: 0.78rem; font-weight: 600; color: var(--accent);
            animation: fadeUp 0.5s ease-out both;
        }
        .badge-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--accent); flex-shrink: 0;
            animation: badgePulse 2.2s ease-in-out infinite;
        }
        @@keyframes badgePulse {
            0%,100% { opacity:1; transform:scale(1); }
            50% { opacity:0.45; transform:scale(0.75); }
        }
        @@keyframes fadeUp {
            from { opacity:0; transform:translateY(-10px); }
            to   { opacity:1; transform:translateY(0); }
        }
        h1.headline {
            font-family: 'Syne', sans-serif;
            font-size: clamp(2rem, 4vw, 2.9rem);
            font-weight: 800; line-height: 1.1;
            color: var(--text); letter-spacing: -0.03em;
            animation: fadeUp 0.6s ease-out 0.08s both;
        }
        h1.headline em { font-style: italic; color: var(--accent); }
        .subtext {
            font-size: 1rem; color: var(--text-muted); line-height: 1.7;
            max-width: 520px;
            animation: fadeUp 0.6s ease-out 0.15s both;
        }

        /* ── SERVICE GRID (55 / 45) ── */
        .service-grid {
            max-width: 1200px; margin: 0 auto;
            padding: 0 2rem;
            display: grid; grid-template-columns: 55fr 45fr;
            gap: 1.75rem; align-items: stretch;
            animation: fadeUp 0.7s ease-out 0.2s both;
        }
        @@media (max-width: 880px) {
            .service-grid { grid-template-columns: 1fr; }
        }

        /* ── LEFT — DEMO PREVIEW CARD ── */
        .demo-col { display: flex; flex-direction: column; }
        .preview-card {
            flex: 1;
            background: rgba(12,12,20,0.84);
            backdrop-filter: blur(22px) saturate(130%);
            -webkit-backdrop-filter: blur(22px) saturate(130%);
            border: 1px solid rgba(255,255,255,0.10);
            border-radius: 1.5rem; overflow: hidden;
            box-shadow: var(--shadow-dark),
                        inset 0 1px 0 rgba(255,255,255,0.06);
            display: flex; flex-direction: column;
        }

        /* Chrome bar */
        .preview-chrome {
            background: rgba(20,20,32,0.90);
            border-bottom: 1px solid rgba(255,255,255,0.07);
            padding: 0.78rem 1.1rem;
            display: flex; align-items: center; justify-content: space-between;
            flex-shrink: 0;
        }
        .chrome-left { display: flex; align-items: center; gap: 0.7rem; }
        .traffic-lights { display: flex; gap: 5px; }
        .tl { width: 10px; height: 10px; border-radius: 50%; }
        .tl-r { background: rgba(255,90,90,0.65); }
        .tl-y { background: rgba(255,196,0,0.65); }
        .tl-g { background: rgba(50,205,90,0.65); }
        .chrome-title {
            font-size: 0.74rem; font-weight: 500; color: rgba(255,255,255,0.36);
        }
        .chrome-title .fn { color: var(--accent); font-weight: 600; }
        .workspace-btn {
            font-size: 0.72rem; font-weight: 600;
            background: rgba(233,150,122,0.12); color: var(--accent);
            border: 1px solid rgba(233,150,122,0.25);
            border-radius: 0.45rem; padding: 0.28rem 0.72rem;
            cursor: pointer; transition: background 0.18s; display: none;
        }
        .workspace-btn:hover { background: rgba(233,150,122,0.22); }

        /* Preview body */
        .preview-body {
            flex: 1; position: relative; min-height: 300px; overflow: hidden;
        }

        /* Actual data table (shown when a real file loads) */
        #dataTable {
            width: 100%; font-size: 0.7rem;
            color: rgba(255,255,255,0.75);
            table-layout: fixed;
            display: none;
        }
        #dataTable thead th {
            position: sticky; top: 0; z-index: 10;
            background: rgba(20,20,32,0.95);
            padding: 0.4rem 0.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            text-align: left; font-weight: 600;
        }
        #dataTable td {
            padding: 0.3rem 0.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }

        /* Loader overlay */
        #loader {
            position: absolute; inset: 0; display: none;
            align-items: center; justify-content: center;
            background: rgba(12,12,20,0.75); backdrop-filter: blur(4px);
        }
        .loader { position: relative; margin: auto; width: 55px; height: 72px; }
        .loader__bar {
            position: absolute; bottom: 0; width: 7px; height: 50%;
            background: rgba(255,255,255,0.6); transform-origin: center bottom;
        }
        .loader__bar:nth-child(1) { left:0px;  animation: barUp1 4s infinite; }
        .loader__bar:nth-child(2) { left:12px; animation: barUp2 4s infinite; }
        .loader__bar:nth-child(3) { left:24px; animation: barUp3 4s infinite; }
        .loader__bar:nth-child(4) { left:36px; animation: barUp4 4s infinite; }
        .loader__bar:nth-child(5) { left:48px; animation: barUp5 4s infinite; }
        .loader__ball {
            position: absolute; bottom: 7px; left: 0;
            width: 7px; height: 7px; background: var(--accent);
            border-radius: 50%; animation: ball624 4s infinite;
        }
        @@keyframes barUp1 { 0%,40%{transform:scale(1,.2)} 50%,90%{transform:scale(1,1)} 100%{transform:scale(1,.2)} }
        @@keyframes barUp2 { 0%,40%{transform:scale(1,.4)} 50%,90%{transform:scale(1,.8)} 100%{transform:scale(1,.4)} }
        @@keyframes barUp3 { 0%,100%{transform:scale(1,.6)} }
        @@keyframes barUp4 { 0%,40%{transform:scale(1,.8)} 50%,90%{transform:scale(1,.4)} 100%{transform:scale(1,.8)} }
        @@keyframes barUp5 { 0%,40%{transform:scale(1,1)} 50%,90%{transform:scale(1,.2)} 100%{transform:scale(1,1)} }
        @@keyframes ball624 {
            0%{transform:translate(0,0)} 5%{transform:translate(6px,-12px)}
            10%{transform:translate(12px,-8px)} 17%{transform:translate(19px,-20px)}
            20%{transform:translate(24px,-16px)} 27%{transform:translate(31px,-28px)}
            30%{transform:translate(36px,-24px)} 37%{transform:translate(43px,-36px)}
            40%{transform:translate(48px,-32px)} 50%{transform:translate(48px,0)}
            57%{transform:translate(41px,-12px)} 60%{transform:translate(34px,-8px)}
            67%{transform:translate(27px,-20px)} 70%{transform:translate(20px,-16px)}
            77%{transform:translate(14px,-28px)} 80%{transform:translate(8px,-24px)}
            87%{transform:translate(3px,-36px)} 90%{transform:translate(0,-32px)}
            100%{transform:translate(0,0)}
        }

        /* ── RIGHT — ACTION COLUMN ── */
        .action-col {
            display: flex; flex-direction: column; gap: 1rem; justify-content: center;
        }

        /* Upload zone */
        .upload-zone {
            background: var(--bg-card); border: 2px dashed rgba(233,150,122,0.32);
            border-radius: 1.4rem; padding: 2.4rem 2rem;
            text-align: center; cursor: pointer; position: relative; overflow: hidden;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .upload-zone::after {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(ellipse at center, rgba(233,150,122,0.04) 0%, transparent 68%);
            pointer-events: none;
        }
        .upload-zone:hover {
            border-color: rgba(233,150,122,0.6);
            box-shadow: 0 0 0 5px rgba(233,150,122,0.06);
        }
        .upload-zone.drag-active {
            border-color: var(--accent);
            background: rgba(233,150,122,0.04);
            box-shadow: 0 0 0 6px rgba(233,150,122,0.09);
        }
        .upload-icon-wrap {
            width: 52px; height: 52px;
            background: var(--accent-light); border-radius: 0.9rem;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem; color: var(--accent);
        }
        .upload-title {
            font-weight: 700; font-size: 1.05rem; color: var(--text); margin-bottom: 0.3rem;
        }
        .upload-hint { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem; }
        .upload-cta-btn {
            display: inline-flex; align-items: center; gap: 0.4rem;
            background: var(--accent); color: #fff; border: none;
            border-radius: 0.7rem; padding: 0.65rem 1.4rem;
            font-family: 'DM Sans', sans-serif; font-size: 0.88rem; font-weight: 700;
            cursor: pointer; transition: background 0.18s;
            box-shadow: 0 2px 10px rgba(233,150,122,0.30);
            pointer-events: none;
        }
        .upload-zone:hover .upload-cta-btn { background: var(--accent-hover); }
        .upload-formats {
            font-size: 0.75rem; color: var(--text-light); margin-top: 0.75rem; line-height: 1.5;
        }
        .upload-prompt {
            display: none; margin-top: 0.8rem; padding: 0.5rem 0.8rem;
            background: var(--accent-light); border-radius: 0.55rem;
            font-size: 0.8rem; color: var(--accent); font-weight: 500;
        }
        .upload-prompt.show { display: block; }

        /* Trust badges */
        .trust-row {
            display: flex; align-items: center; justify-content: center;
            gap: 1.6rem; flex-wrap: wrap;
        }
        .trust-item {
            display: flex; align-items: center; gap: 0.4rem;
            font-size: 0.8rem; font-weight: 500; color: var(--text-muted);
        }
        .trust-check {
            width: 18px; height: 18px; border-radius: 50%;
            background: rgba(34,197,94,0.1); color: #22C55E;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.7rem; font-weight: 700; flex-shrink: 0;
        }

        /* Sign-in nudge */
        .signin-nudge {
            text-align: center; font-size: 0.8rem; color: var(--text-light);
        }
        .signin-nudge a {
            color: var(--accent); font-weight: 600; text-decoration: none;
        }
        .signin-nudge a:hover { text-decoration: underline; }

        /* ── Guest file list ── */
        .guest-file-list {
            margin-top: 1.25rem;
            background: #fff;
            border: 1px solid rgba(0,0,0,0.07);
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        }
        .guest-file-list-title {
            font-weight: 700; font-size: 0.8rem; color: var(--text-light);
            text-transform: uppercase; letter-spacing: 0.06em;
            padding: 0.7rem 1.1rem 0.4rem;
            margin: 0;
        }
        .guest-file-row {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.7rem 1.1rem;
            border-top: 1px solid rgba(0,0,0,0.055);
            cursor: pointer; transition: background 0.13s;
        }
        .guest-file-row:hover { background: rgba(233,150,122,0.06); }
        .guest-file-name { flex: 1; font-weight: 600; font-size: 0.88rem; color: var(--text); }
        .guest-file-date { font-size: 0.76rem; color: var(--text-light); white-space: nowrap; }
        .guest-file-delete {
            background: none; border: none; cursor: pointer;
            color: #EF4444; font-size: 0.76rem; font-weight: 600;
            padding: 0.25rem 0.5rem; border-radius: 0.35rem;
            transition: background 0.13s;
        }
        .guest-file-delete:hover { background: rgba(239,68,68,0.08); }
        .guest-file-expiry-note {
            font-size: 0.74rem; color: var(--text-light);
            padding: 0.6rem 1.1rem; margin: 0;
            border-top: 1px solid rgba(0,0,0,0.055);
        }
        .guest-file-expiry-note a { color: var(--accent); font-weight: 600; text-decoration: none; }
        .guest-file-expiry-note a:hover { text-decoration: underline; }

        /* ── AUTH MODAL ── */
        .auth-overlay {
            position: fixed; inset: 0; z-index: 200;
            background: rgba(248,248,252,0.78);
            backdrop-filter: blur(18px) saturate(140%);
            -webkit-backdrop-filter: blur(18px) saturate(140%);
            display: flex; align-items: center; justify-content: center;
            padding: 1.5rem;
            opacity: 0; pointer-events: none;
            transition: opacity 0.2s ease;
        }
        .auth-overlay.open { opacity: 1; pointer-events: all; }
        .auth-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 1.4rem; padding: 1.75rem;
            width: 100%; max-width: 400px;
            box-shadow: 0 24px 64px rgba(0,0,0,0.11), 0 8px 24px rgba(0,0,0,0.07);
            transform: scale(0.95) translateY(12px);
            transition: transform 0.26s cubic-bezier(0.34,1.56,0.64,1);
        }
        .auth-overlay.open .auth-card { transform: scale(1) translateY(0); }
        .modal-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 1.25rem;
        }
        .modal-title {
            font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700;
            color: var(--text); letter-spacing: -0.02em;
        }
        .modal-close {
            width: 28px; height: 28px; border-radius: 0.45rem;
            background: none; border: none; cursor: pointer;
            color: var(--text-light); display: flex; align-items: center; justify-content: center;
            transition: background 0.15s, color 0.15s; flex-shrink: 0;
        }
        .modal-close:hover { background: rgba(0,0,0,0.06); color: var(--text); }
        .tab-bar {
            display: flex; border-bottom: 1px solid rgba(0,0,0,0.07);
            margin-bottom: 1.4rem;
        }
        .tab-btn {
            background: none; border: none; border-bottom: 2px solid transparent;
            margin-bottom: -1px; padding: 0.42rem 0; margin-right: 1.4rem;
            font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 600;
            color: var(--text-muted); cursor: pointer; transition: all 0.18s;
        }
        .tab-btn.tab-active { color: var(--text); border-bottom-color: var(--accent); }
        .tab-btn:hover { color: var(--text); }

        .form-group { display: flex; flex-direction: column; gap: 0.55rem; }
        .form-input {
            width: 100%; background: #F4F4F5; color: var(--text);
            border: 1px solid rgba(0,0,0,0.08); border-radius: 0.65rem;
            padding: 0.65rem 0.85rem;
            font-family: 'DM Sans', sans-serif; font-size: 0.875rem;
            outline: none; transition: all 0.18s;
        }
        .form-input::placeholder { color: #A1A1AA; }
        .form-input:focus {
            border-color: var(--accent); background: #fff;
            box-shadow: 0 0 0 3px rgba(233,150,122,0.12);
        }
        .error-border { border-color: #EF4444 !important; }
        .error-log { color: #EF4444; font-size: 0.72rem; margin-top: 0.15rem; }
        @@keyframes shake {
            0%,100% { transform:translateX(0); }
            15%,45%,75% { transform:translateX(-5px); }
            30%,60%,90% { transform:translateX(5px); }
        }
        .shake { animation: shake 0.38s ease-in-out; }
        .form-submit {
            width: 100%; margin-top: 0.4rem;
            background: var(--accent); color: #fff;
            border: none; border-radius: 0.65rem; padding: 0.7rem;
            font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 700;
            letter-spacing: 0.025em; cursor: pointer; transition: background 0.18s, transform 0.1s;
        }
        .form-submit:hover { background: var(--accent-hover); }
        .form-submit:active { transform: scale(0.99); }

        /* ── SOCIAL PROOF ── */
        .proof-section {
            max-width: 1200px; margin: 3rem auto 0;
            padding: 2rem 2rem 2.5rem;
            border-top: 1px solid rgba(0,0,0,0.06);
            text-align: center;
        }
        .proof-label {
            font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
            text-transform: uppercase; color: var(--text-light); margin-bottom: 1.4rem;
        }
        .proof-items {
            display: flex; flex-wrap: wrap; align-items: center;
            justify-content: center; gap: 1.25rem 2.75rem;
        }
        .proof-item {
            font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700;
            color: rgba(0,0,0,0.10); letter-spacing: -0.015em; user-select: none;
        }
        .proof-launch { margin-top: 1.25rem; font-size: 0.8rem; color: var(--text-light); }
        .proof-launch span { color: var(--accent); font-weight: 600; }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("signinbutton1").addEventListener("click", signIn);
            document.getElementById("registerbutton1").addEventListener("click", register);
            document.getElementById("tab-signin").addEventListener("click",  () => showTab('signin'));
            document.getElementById("tab-register").addEventListener("click", () => showTab('register'));
            document.querySelector('.nav-cta').addEventListener('click', () => openModal('signin'));
            document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
        });

        function openModal(tab) {
            document.getElementById('authOverlay').classList.add('open');
            document.body.style.overflow = 'hidden';
            showTab(tab || 'signin');
            setTimeout(() => {
                const id = (tab === 'register') ? 'nameinputr' : 'nameinput';
                document.getElementById(id).focus();
            }, 260);
        }

        function closeModal() {
            document.getElementById('authOverlay').classList.remove('open');
            document.body.style.overflow = '';
        }

        function focusAuth() { openModal('signin'); }

        function showTab(type) {
            const siGroup  = document.getElementById('signin-group');
            const regGroup = document.getElementById('register-group');
            const btnSi    = document.getElementById('tab-signin');
            const btnReg   = document.getElementById('tab-register');
            if (type === 'signin') {
                regGroup.classList.add('hidden');
                siGroup.classList.remove('hidden');
                btnReg.classList.remove('tab-active');
                btnSi.classList.add('tab-active');
                document.getElementById('nameinput').focus();
            } else {
                siGroup.classList.add('hidden');
                regGroup.classList.remove('hidden');
                btnSi.classList.remove('tab-active');
                btnReg.classList.add('tab-active');
                document.getElementById('nameinputr').focus();
            }
        }

        async function signIn() {
            const res = await fetch("@Url.Action("SignIn","Auth")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({
                    aname:     document.getElementById('nameinput').value,
                    apassword: document.getElementById('pwinput').value
                })
            });
            const result = await res.json();
            if (result.redirect) window.location.href = result.redirect;
        }

        async function register() {
            document.querySelectorAll('#register-group .error-log').forEach(e => e.remove());
            document.querySelectorAll('#register-group input').forEach(i => {
                i.classList.remove('error-border', 'shake');
                i._errorLog = null;
            });
            const data = {
                name:            document.getElementById('nameinputr').value,
                email:           document.getElementById('emailinputr').value,
                password:        document.getElementById('pwinputr').value,
                confirmpassword: document.getElementById('pwconfirminputr').value,
            };
            const res = await fetch("@Url.Action("Register","Auth")", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.redirect)   window.location.href = result.redirect;
            else if (result.error) handleRegisterError(result);
            else throw new Error("Unexpected response");
        }

        function handleRegisterError(result) {
            const g = {
                name:            document.getElementById('nameinputr'),
                email:           document.getElementById('emailinputr'),
                password:        document.getElementById('pwinputr'),
                confirmpassword: document.getElementById('pwconfirminputr'),
            };
            if (result.error !== "Requirements not met!" && result.error !== "Registration failed.") return;
            const details = result.details || [];
            const has = msg => details.some(d => d.includes(msg));
            if (has("Username is required") || has("Username must be between")) shakeLog(g.name, "Invalid username");
            if (has("Email is required")    || has("Invalid email"))            shakeLog(g.email, "Invalid email");
            if (has("Passwords do not match"))                                  shakeLog(g.confirmpassword, "Passwords do not match");
            const pwErrors = [];
            if (has("Password is required"))                       pwErrors.push("Password required");
            if (has("Passwords must be at least 8"))               pwErrors.push("At least 8 characters");
            if (has("Passwords must have at least one non"))       pwErrors.push("1 special character");
            if (has("Passwords must have at least one lowercase")) pwErrors.push("1 lowercase letter");
            if (has("Passwords must have at least one uppercase")) pwErrors.push("1 uppercase letter");
            if (pwErrors.length > 0) shakeLog(g.password, pwErrors.join(", "));
        }

        function shakeLog(input, msg) {
            input.classList.add('error-border', 'shake');
            if (input._errorLog) input._errorLog.remove();
            const log = document.createElement('div');
            log.className = 'error-log'; log.textContent = msg;
            input.insertAdjacentElement('beforebegin', log);
            input._errorLog = log;
            setTimeout(() => input.classList.remove('shake'), 420);
        }

        // Upload zone — guest upload
        function triggerFilePicker() { document.getElementById('guestFileInput').click(); }
        function handleDragOver(e) {
            e.preventDefault();
            document.getElementById('uploadZone').classList.add('drag-active');
        }
        function handleDragLeave() {
            document.getElementById('uploadZone').classList.remove('drag-active');
        }
        function handleDrop(e) {
            e.preventDefault();
            document.getElementById('uploadZone').classList.remove('drag-active');
            const file = e.dataTransfer.files[0];
            if (file) uploadGuestFile(file);
        }

        async function uploadGuestFile(file) {
            if (!file) return;
            const fd = new FormData();
            fd.append('file', file);
            const res = await fetch('/guest-upload', { method: 'POST', body: fd });
            const r = await res.json();
            if (r.received) location.reload();
            else alert(`"${r.badcsv || file.name}" is not a valid CSV, or a file with that name already exists.`);
        }

        async function removeGuestFile(filename, containerId, e) {
            e.stopPropagation();
            if (!confirm(`Delete "${filename}"? This cannot be undone.`)) return;
            const res = await fetch('/guest-remove?' + new URLSearchParams({ filename }), { method: 'DELETE' });
            if (await res.json() === 'OK') document.getElementById(containerId).remove();
        }

        async function selectGuestFile(filename) {
            const res = await fetch('/table', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `filename=${encodeURIComponent(filename)}`
            });
            if (res.ok) window.location.href = '/workspace';
        }

        // Star canvas
        (function initStars() {
            const canvas = document.getElementById('starCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let W, H, stars = [];
            function resize() {
                W = canvas.width  = window.innerWidth;
                H = canvas.height = window.innerHeight;
                stars = Array.from({ length: 85 }, () => ({
                    x:  Math.random() * W,
                    y:  Math.random() * H,
                    r:  Math.random() * 1.1 + 0.2,
                    a:  Math.random() * 0.16 + 0.04,
                    da: (Math.random() - 0.5) * 0.002,
                    dx: (Math.random() - 0.5) * 0.065,
                    dy: (Math.random() - 0.5) * 0.065,
                }));
            }
            function draw() {
                ctx.clearRect(0, 0, W, H);
                for (const s of stars) {
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(210,110,80,${s.a})`;
                    ctx.fill();
                    s.a += s.da;
                    if (s.a > 0.20 || s.a < 0.03) s.da *= -1;
                    s.x += s.dx; s.y += s.dy;
                    if (s.x < -4) s.x = W + 4; if (s.x > W + 4) s.x = -4;
                    if (s.y < -4) s.y = H + 4; if (s.y > H + 4) s.y = -4;
                }
                requestAnimationFrame(draw);
            }
            window.addEventListener('resize', resize);
            resize(); draw();
        })();
    </script>
</head>
<body>
<canvas id="starCanvas"></canvas>

<!-- ── Auth Modal ── -->
<div id="authOverlay" class="auth-overlay" onclick="if(event.target===this) closeModal()">
    <div class="auth-card" id="auth-card">
        <div class="modal-header">
            <span class="modal-title">Welcome to ACPTDA</span>
            <button class="modal-close" onclick="closeModal()" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="tab-bar">
            <button class="tab-btn tab-active" id="tab-signin">Sign In</button>
            <button class="tab-btn" id="tab-register">Register</button>
        </div>

        <div id="signin-group" class="form-group">
            <input class="form-input" type="text"     id="nameinput"  placeholder="Name or Email"  autocomplete="username">
            <input class="form-input" type="password" id="pwinput"    placeholder="Password"        autocomplete="current-password">
            <button class="form-submit" id="signinbutton1">SIGN IN</button>
        </div>

        <div id="register-group" class="form-group hidden">
            <input class="form-input" type="text"     id="nameinputr"      placeholder="Your name">
            <input class="form-input" type="text"     id="emailinputr"     placeholder="Email address"    autocomplete="email">
            <input class="form-input" type="password" id="pwinputr"        placeholder="Password"          autocomplete="new-password">
            <input class="form-input" type="password" id="pwconfirminputr" placeholder="Confirm password">
            <button class="form-submit" id="registerbutton1">CREATE ACCOUNT</button>
        </div>
    </div>
</div>

<!-- ── Floating Nav Pill ── -->
<header class="nav-wrapper">
    <nav class="nav-pill">
        <a href="#" class="nav-logo">
            <img src="01384a5a5e3c1ea5887b428641e12121.gif" alt="" style="width:18px;height:auto;">
            ACPTDA<span class="dot">.</span>
        </a>
        <div class="nav-links">
            <a href="#">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a4 4 0 0 0-4-4H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a4 4 0 0 1 4-4h6z"/></svg>
                Docs
            </a>
            <a href="#">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/></svg>
                GitHub
            </a>
            <a href="#">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                Contact
            </a>
        </div>
        <button class="nav-cta">Sign In</button>
    </nav>
</header>

<main class="page">

    <!-- ── Centered Hero Intro ── -->
    <div class="hero-intro">
        <div class="badge">
            <span class="badge-dot"></span>
            Just launched &mdash; now in early access
        </div>
        <h1 class="headline">
            Visualize your CSV in just a couple of clicks
        </h1>
        <p class="subtext">
            Upload a file and easily visualize your data with interactive charts.
            Simple data cleaning and transformation supported. 
        </p>
    </div>

    <!-- ── Service Grid: Demo (left 55%) | Upload (right 45%) ── -->
    <div class="service-grid">

        <!-- LEFT — Dark glassmorphism preview card -->
        <div class="demo-col">
            <div class="preview-card">

                <!-- Chrome bar -->
                <div class="preview-chrome">
                    <div class="chrome-left">
                        <div class="traffic-lights">
                            <span class="tl tl-r"></span>
                            <span class="tl tl-y"></span>
                            <span class="tl tl-g"></span>
                        </div>
                        <span class="chrome-title">
                            preview<span class="fn" id="previewFilename">&nbsp;&mdash;&nbsp;sample_data.csv</span>
                        </span>
                    </div>
                    <button class="workspace-btn" id="workspaceButton"
                            onclick="window.location.href='/workspace'">
                        Open Workspace &rarr;
                    </button>
                </div>

                <!-- Preview body -->
                <div class="preview-body">

                    <!-- Video placeholder — replace src when ready -->
                    <div id="noPreview" style="position:absolute;inset:0;"></div>

                    <!-- Real data table (populated by select()) -->
                    <div style="position:absolute;inset:0;overflow:auto;display:none;" id="dataTableWrap">
                        <table id="dataTable"></table>
                    </div>

                    <!-- Loader -->
                    <div id="loader" class="loader-overlay" hidden>
                        <div class="loader">
                            <div class="loader__bar"></div><div class="loader__bar"></div>
                            <div class="loader__bar"></div><div class="loader__bar"></div>
                            <div class="loader__bar"></div><div class="loader__ball"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT — Upload zone + trust -->
        <div class="action-col">
            <input type="file" id="guestFileInput" accept=".csv" style="display:none"
                   onchange="uploadGuestFile(this.files[0])">
            <div class="upload-zone"
                 id="uploadZone"
                 onclick="triggerFilePicker()"
                 ondragover="handleDragOver(event)"
                 ondragleave="handleDragLeave(event)"
                 ondrop="handleDrop(event)">
                <div class="upload-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <p class="upload-title">Drop your CSV file here</p>
                <p class="upload-hint">or click to browse your files</p>
                <div class="upload-cta-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    Upload CSV
                </div>
                <p class="upload-formats">.csv &nbsp;&middot;&nbsp; up to 200 MB</p>
            </div>

            <div class="trust-row">
                <span class="trust-item">
                    <span class="trust-check">&#10003;</span>
                    Free to use
                </span>
                <span class="trust-item">
                    <span class="trust-check">&#10003;</span>
                    No sign-in required
                </span>
            </div>

            <p class="signin-nudge">
                <a href="#" onclick="openModal('signin'); return false;">Sign in</a>
                to save files and access your full workspace
            </p>

            @if (Model != null && Model.Any())
            {
                <div class="guest-file-list">
                    <p class="guest-file-list-title">Your uploaded files</p>
                    @foreach (var (file, i) in Model.Select((f, i) => (f, i)))
                    {
                        <div id="guestfile-@i"
                             class="guest-file-row"
                             onclick="selectGuestFile('@file.Name')">
                            <span class="guest-file-name">@file.Name</span>
                            <span class="guest-file-date">@file.CreatedTime.ToString("MMM d, yyyy")</span>
                            <button class="guest-file-delete"
                                    onclick="removeGuestFile('@file.Name','guestfile-@i',event)">
                                Delete
                            </button>
                        </div>
                    }
                    <p class="guest-file-expiry-note">
                        Guest files are deleted after 7 days. &nbsp;
                        <a href="#" onclick="openModal('signin'); return false;">Sign in</a>
                        to keep them permanently.
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- ── Social Proof Strip ── -->
    <section class="proof-section">
        <p class="proof-label">Built for your convenience</p>
        <div class="proof-items">
            <span class="proof-item">University Research</span>
            <span class="proof-item">Data Analytics</span>
            <span class="proof-item">Business Intelligence</span>
            <span class="proof-item">Academic Studies</span>
            <span class="proof-item">Market Research</span>
        </div>
        <p class="proof-launch">Launching soon &mdash; <span>be among the first to experience it</span></p>
    </section>

</main>

</body>
</html>
