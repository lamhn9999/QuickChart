@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>LQ</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style.css"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document
                .getElementById("signinbutton1")
                .addEventListener("click", signIn);
        });
        async function signIn()
        {
            const yourname = document.getElementById("nameinput1").value;
            const response = await fetch("@Url.Action("SignIn", "Auth")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `aname=${encodeURIComponent(yourname)}`
            });
            console.log(response);
            const result = await response.json();
            if (result.redirect) {
                window.location.href = result.redirect;
            }
        }
    </script>
</head>
<body>
<div style = "display: flex; gap: var(--main-div-gap);">
    <div style="width: 50vw">
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h1 class = "glossy">LQ</h1>
            <p style="width: 0; font-size: var(--main-div-gap)">Automatic CSV Plotter.</p>
        </div>
        <h2 class="listlabel">Select a sample CSV</h2>
        <div>
            @foreach (string file in Model)
            {
                <div class="listelement">
                    <div class="listline"></div>
                    <div class="listfile">@file</div>
                </div>
            }
        </div>
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h2>or</h2>
            <button class="signinbutton" id="signinbutton1">Sign In</button>
            <input type="text" id="nameinput1"/>
            <h2>to</h2>
        </div>
        <div style="position: relative; width: fit-content">
            <div style="display:flex; align-items:center; gap: var(--main-div-gap); position: relative; z-index: 1">
                <h2 style="color: darkgrey">Upload a CSV</h2>
            </div>
            <div class="sealed">
                <div class="sealed-track">
                    <div class="sealed-segment">sealed sealed sealed sealed sealed sealed sealed sealed</div>
                    <div class="sealed-segment">sealed sealed sealed sealed sealed sealed sealed</div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>