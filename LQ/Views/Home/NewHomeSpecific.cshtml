@model List<LQ.Models.TableModels.CSVFile>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>ACPTDA — My Workspaces</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="01384a5a5e3c1ea5887b428641e12121.gif" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #F7F7FA;
            --bg-card: #FFFFFF;
            --nav-bg: rgba(255,255,255,0.88);
            --text: #18181B;
            --text-muted: #71717A;
            --text-light: #A1A1AA;
            --accent: #E9967A;
            --accent-light: rgba(233,150,122,0.09);
            --accent-hover: #D4836A;
            --border: rgba(0,0,0,0.07);
            --border-row: rgba(0,0,0,0.055);
            --shadow-nav: 0 1px 0 rgba(0,0,0,0.06), 0 2px 16px rgba(0,0,0,0.05);
            --shadow-card: 0 1px 4px rgba(0,0,0,0.05), 0 4px 20px rgba(0,0,0,0.06);
        }
        *, *::before, *::after { box-sizing: border-box; margin:0; padding:0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            background-image: radial-gradient(rgba(0,0,0,0.05) 1px, transparent 0);
            background-size: 28px 28px;
            color: var(--text);
            min-height: 100vh;
        }

        /* ── TOP NAV ── */
        .topnav {
            position: sticky; top: 0; z-index: 50;
            background: var(--nav-bg);
            backdrop-filter: blur(18px) saturate(150%);
            -webkit-backdrop-filter: blur(18px) saturate(150%);
            border-bottom: 1px solid rgba(0,0,0,0.07);
            box-shadow: var(--shadow-nav);
            padding: 0.7rem 2rem;
            display: flex; align-items: center; justify-content: space-between;
        }
        .nav-brand {
            display: flex; align-items: center; gap: 0.5rem;
            font-family: 'Syne', sans-serif; font-weight: 700;
            font-size: 0.95rem; color: var(--text); text-decoration: none;
            letter-spacing: -0.02em;
        }
        .nav-brand .dot { color: var(--accent); }
        .nav-right { display: flex; align-items: center; gap: 1rem; }
        .nav-user {
            font-size: 0.82rem; font-weight: 500; color: var(--text-muted);
            padding-right: 1rem; border-right: 1px solid var(--border);
        }
        .nav-user .username { color: var(--accent); font-weight: 600; }
        .signout-btn {
            display: flex; align-items: center; gap: 0.4rem;
            font-size: 0.82rem; font-weight: 500; color: var(--text-muted);
            background: none; border: none; cursor: pointer;
            transition: color 0.18s; padding: 0.35rem 0.6rem;
            border-radius: 0.45rem;
        }
        .signout-btn:hover { color: var(--text); background: rgba(0,0,0,0.04); }

        /* ── MAIN CONTENT ── */
        .main-content {
            max-width: 1100px; margin: 0 auto;
            padding: 2.5rem 2rem 4rem;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            display: flex; align-items: flex-end; justify-content: space-between;
            padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);
            margin-bottom: 1.75rem; gap: 1rem;
        }
        .page-header-text h2 {
            font-family: 'Syne', sans-serif; font-weight: 800;
            font-size: 1.85rem; color: var(--text); letter-spacing: -0.03em;
            margin-bottom: 0.35rem;
        }
        .page-header-text p { font-size: 0.85rem; color: var(--text-muted); }

        /* Upload button */
        .upload-btn {
            display: inline-flex; align-items: center; gap: 0.45rem;
            background: var(--accent); color: #fff;
            border: none; border-radius: 0.7rem;
            padding: 0.6rem 1.25rem;
            font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 600;
            cursor: pointer; transition: background 0.18s, transform 0.1s;
            box-shadow: 0 2px 10px rgba(233,150,122,0.28); flex-shrink: 0;
        }
        .upload-btn:hover { background: var(--accent-hover); }
        .upload-btn:active { transform: scale(0.98); }

        /* ── FILE TABLE ── */
        .file-table-wrap {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 1.1rem; overflow: hidden;
            box-shadow: var(--shadow-card);
        }

        /* Table header bar */
        .table-header {
            display: flex; align-items: center;
            background: #F4F4F6; border-bottom: 1px solid var(--border-row);
            font-size: 0.775rem; font-weight: 700;
            color: var(--text-muted); letter-spacing: 0.03em; text-transform: uppercase;
        }
        .th-name {
            flex: 1; padding: 0.75rem 1.25rem;
            cursor: pointer; user-select: none; transition: background 0.15s;
            display: flex; align-items: center; gap: 0.35rem;
        }
        .th-name:hover { background: rgba(0,0,0,0.03); }
        .th-date {
            width: 8.5rem; padding: 0.75rem 1.25rem;
            cursor: pointer; user-select: none; transition: background 0.15s;
            display: flex; align-items: center; gap: 0.35rem;
        }
        .th-date:hover { background: rgba(0,0,0,0.03); }

        /* File rows */
        #fileListContainer { display: flex; flex-direction: column; }
        .file-row {
            display: flex; align-items: center;
            border-bottom: 1px solid var(--border-row);
            cursor: pointer; transition: background 0.14s;
        }
        .file-row:last-child { border-bottom: none; }
        .file-row:hover { background: rgba(128,128,128,0.1); }

        .file-main {
            flex: 1; padding: 0.85rem 1.25rem;
            display: flex; align-items: center; gap: 0.85rem;
        }
        .file-icon {
            width: 34px; height: 34px; border-radius: 0.55rem; flex-shrink: 0;
            color: var(--accent);
            display: flex; align-items: center; justify-content: center;
        }
        .file-info { display: flex; flex-direction: column; flex: 1; min-width: 0; }
        .file-name-row { display: flex; align-items: center; gap: 0.5rem; }
        .filename-text {
            font-weight: 600; font-size: 0.9rem; color: var(--text);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .filename-input {
            font-family: 'DM Sans', sans-serif;
            background: #F4F4F5; color: var(--text);
            border: 1.5px solid var(--accent); border-radius: 0.45rem;
            padding: 0.25rem 0.55rem; font-size: 0.875rem; outline: none;
            flex: 1;
        }
        .file-meta { font-size: 0.75rem; color: var(--text-light); margin-top: 0.15rem; }

        /* Row actions (shown on hover) */
        .file-actions {
            position: relative; display: inline-block;
            opacity: 0; transition: opacity 0.15s;
        }
        .file-row:hover .file-actions,
        .file-actions:focus-within { opacity: 1; }
        .actions-btn {
            width: 28px; height: 28px; border-radius: 0.4rem;
            background: none; border: none; cursor: pointer;
            color: var(--text-muted); display: flex; align-items: center; justify-content: center;
            transition: background 0.15s, color 0.15s;
        }
        .actions-btn:hover { background: rgba(0,0,0,0.06); color: var(--text); }
        .dropdown-menu {
            position: absolute; top: calc(100% + 4px); left: 0;
            width: 9rem; background: var(--bg-card);
            border: 1px solid var(--border); border-radius: 0.65rem;
            box-shadow: 0 8px 28px rgba(0,0,0,0.1), 0 2px 6px rgba(0,0,0,0.05);
            overflow: hidden; z-index: 60;
        }
        .dropdown-menu.hidden { display: none; }
        .dropdown-item {
            width: 100%; text-align: left; padding: 0.5rem 0.9rem;
            font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 500;
            background: none; border: none; cursor: pointer;
            color: var(--text-muted); transition: background 0.12s, color 0.12s;
        }
        .dropdown-item:hover { background: #F4F4F6; color: var(--text); }
        .dropdown-item.danger { color: #EF4444; }
        .dropdown-item.danger:hover { background: rgba(239,68,68,0.06); color: #DC2626; }

        .file-date {
            width: 8.5rem; padding: 0.85rem 1.25rem;
            font-size: 0.8rem; color: var(--text-muted);
            white-space: nowrap;
        }

        /* Empty state */
        .empty-state {
            padding: 4rem 2rem; display: flex; flex-direction: column;
            align-items: center; justify-content: center; text-align: center;
        }
        .empty-icon {
            width: 60px; height: 60px; border-radius: 50%;
            background: #F4F4F6; color: var(--text-light);
            display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;
        }
        .empty-state h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.05rem; color: var(--text); margin-bottom: 0.35rem; }
        .empty-state p  { font-size: 0.85rem; color: var(--text-muted); }

        /* ── GLOBAL LOADER ── */
        #global-loader {
            position: fixed; inset: 0;
            background: rgba(247,247,250,0.88); backdrop-filter: blur(8px);
            z-index: 100; display: none;
            flex-direction: column; align-items: center; justify-content: center;
        }
        #global-loader.show { display: flex; }
        .loader { position: relative; margin: auto; width: 60px; height: 80px; }
        .loader__bar {
            position: absolute; bottom: 0; width: 8px; height: 50%;
            background: rgba(233,150,122,0.65); transform-origin: center bottom;
        }
        .loader__bar:nth-child(1) { left:0px;  animation: barUp1 4s infinite; }
        .loader__bar:nth-child(2) { left:13px; animation: barUp2 4s infinite; }
        .loader__bar:nth-child(3) { left:26px; animation: barUp3 4s infinite; }
        .loader__bar:nth-child(4) { left:39px; animation: barUp4 4s infinite; }
        .loader__bar:nth-child(5) { left:52px; animation: barUp5 4s infinite; }
        .loader__ball {
            position: absolute; bottom: 8px; left: 0;
            width: 8px; height: 8px; background: var(--accent);
            border-radius: 50%; animation: ball624 4s infinite;
        }
        @@keyframes barUp1 { 0%,40%{transform:scale(1,.2)} 50%,90%{transform:scale(1,1)} 100%{transform:scale(1,.2)} }
        @@keyframes barUp2 { 0%,40%{transform:scale(1,.4)} 50%,90%{transform:scale(1,.8)} 100%{transform:scale(1,.4)} }
        @@keyframes barUp3 { 0%,100%{transform:scale(1,.6)} }
        @@keyframes barUp4 { 0%,40%{transform:scale(1,.8)} 50%,90%{transform:scale(1,.4)} 100%{transform:scale(1,.8)} }
        @@keyframes barUp5 { 0%,40%{transform:scale(1,1)} 50%,90%{transform:scale(1,.2)} 100%{transform:scale(1,1)} }
        @@keyframes ball624 {
            0%{transform:translate(0,0)} 5%{transform:translate(7px,-13px)}
            10%{transform:translate(14px,-9px)} 17%{transform:translate(21px,-22px)}
            20%{transform:translate(28px,-18px)} 27%{transform:translate(35px,-31px)}
            30%{transform:translate(42px,-27px)} 37%{transform:translate(49px,-40px)}
            40%{transform:translate(52px,-36px)} 50%{transform:translate(52px,0)}
            57%{transform:translate(45px,-13px)} 60%{transform:translate(38px,-9px)}
            67%{transform:translate(31px,-22px)} 70%{transform:translate(24px,-18px)}
            77%{transform:translate(17px,-31px)} 80%{transform:translate(10px,-27px)}
            87%{transform:translate(4px,-40px)} 90%{transform:translate(0,-36px)}
            100%{transform:translate(0,0)}
        }
        .loader-text {
            margin-top: 1.6rem; font-size: 0.75rem; font-weight: 700;
            letter-spacing: 0.12em; text-transform: uppercase;
            color: var(--accent); animation: textPulse 1.6s ease-in-out infinite;
        }
        @@keyframes textPulse { 0%,100%{opacity:1} 50%{opacity:0.45} }

        /* ── FILE-CARD LOADING BAR ── */
        .file-row { position: relative; }
        .file-loading-bar {
            position: absolute; left: 0; right: 0; bottom: 0;
            height: 2px; overflow: hidden;
            background: rgba(233,150,122,0.12);
            pointer-events: none;
        }
        .file-loading-bar::before {
            content: ""; position: absolute; inset: 0;
            background: linear-gradient(90deg,
                transparent 0%,
                var(--accent) 35%,
                var(--accent) 55%,
                transparent 100%);
            transform: translateX(-100%);
            animation: cardBarSlide 1.4s cubic-bezier(.45,.05,.55,.95) infinite;
        }
        @@keyframes cardBarSlide {
            0%   { transform: translateX(-100%); }
            100% { transform: translateX(220%); }
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const signOutBtn = document.getElementById("signoutbutton");
            if (signOutBtn) signOutBtn.addEventListener("click", signOut);
            document.addEventListener("click", () => {
                document.querySelectorAll('.dropdown-menu').forEach(el => el.classList.add('hidden'));
            });
            sortTable(1, 'date', false);
        });

        function toggleDropdown(btn, event) {
            event.stopPropagation();
            const dropdown = btn.nextElementSibling;
            const isHidden = dropdown.classList.contains('hidden');
            document.querySelectorAll('.dropdown-menu').forEach(el => el.classList.add('hidden'));
            if (isHidden) dropdown.classList.remove('hidden');
        }

        async function removeFile(filename, containerId, event) {
            event.stopPropagation();
            if (!confirm(`Delete "${filename}"? This cannot be undone.`)) return;
            const response = await fetch("@Url.Action("Remove", "Home")", {
                method: "DELETE",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `filename=${encodeURIComponent(filename)}`
            });
            const result = await response.json();
            if (result === "OK") document.getElementById(containerId).remove();
        }

        function renameAction(containerId, event) {
            event.stopPropagation();
            const element  = document.getElementById(containerId);
            const fileText = element.querySelector(".filename-text");
            const oldName  = fileText.textContent;

            const input = document.createElement("input");
            input.type  = "text";
            input.value = oldName;
            input.className = "filename-input";
            input.onclick = (e) => e.stopPropagation();

            fileText.replaceWith(input);
            input.focus(); input.select();

            let isRenaming = false;

            input.addEventListener("keydown", (e) => {
                if (e.key === "Enter")  finishRename();
                if (e.key === "Escape") cancelRename();
            });
            input.addEventListener("blur", finishRename);

            function cancelRename() {
                if (isRenaming) return;
                isRenaming = true;
                input.replaceWith(fileText);
            }
            function finishRename() {
                if (isRenaming) return;
                isRenaming = true;
                const newName = input.value.trim();
                input.replaceWith(fileText);
                if (!newName || newName === oldName) return;
                rename(oldName, newName, containerId);
            }
        }

        async function rename(filename, newfilename, containerId) {
            const response = await fetch("@Url.Action("RenameFile","Home")", {
                method: "PUT",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `oldfilename=${encodeURIComponent(filename)}&newfilename=${encodeURIComponent(newfilename)}`
            });
            const result = await response.json();
            if (result === "OK") location.reload();
        }

        async function upload() {
            const form     = document.getElementById('uploadForm');
            const formData = new FormData(form);
            const response = await fetch("@Url.Action("Upload", "Home")", {
                method: form.method || 'POST',
                body: formData
            });
            await response.json();
            document.getElementById('fileInput').value = "";
            location.reload();
        }

        // Per-card status polling: while any file is still Processing, poll
        // /pending-uploads and remove the loading bar from cards whose status
        // has flipped off Processing (Ready, AwaitingListConfirmation, Failed).
        let _statusPollTimer = null;
        async function refreshCardStatuses() {
            const bars = document.querySelectorAll('.file-loading-bar');
            if (bars.length === 0) {
                if (_statusPollTimer) { clearInterval(_statusPollTimer); _statusPollTimer = null; }
                return;
            }
            try {
                const res = await fetch('/pending-uploads');
                if (!res.ok) return;
                const items = await res.json();
                const stillProcessing = new Set(
                    items.filter(i => i.status === 'Processing').map(i => i.token)
                );
                bars.forEach(bar => {
                    const card = bar.closest('[data-token]');
                    if (card && !stillProcessing.has(card.dataset.token)) bar.remove();
                });
            } catch (_) { /* best-effort */ }
        }
        document.addEventListener('DOMContentLoaded', () => {
            if (document.querySelector('.file-loading-bar')) {
                _statusPollTimer = setInterval(refreshCardStatuses, 4000);
            }
        });

        async function select(filename) {
            const loader = document.getElementById('global-loader');
            loader.classList.add('show');
            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `filename=${encodeURIComponent(filename)}`
            });
            if (response.ok) {
                window.location.href = '/workspace';
            } else {
                loader.classList.remove('show');
                alert("Failed to load workspace.");
            }
        }

        async function signOut() {
            const response = await fetch("@Url.Action("SignOut","Auth")", { method: "POST" });
            const result   = await response.json();
            if (result.redirect) window.location.href = result.redirect;
        }

        let currentSortColumn = -1;
        let sortDirection = false;
        function sortTable(columnIndex, type, forceDirection = null) {
            const container = document.getElementById("fileListContainer");
            if (!container) return;
            const rows = Array.from(container.querySelectorAll(".file-row"));
            if (rows.length === 0) return;
            if (forceDirection !== null) {
                sortDirection = forceDirection;
            } else if (currentSortColumn === columnIndex) {
                sortDirection = !sortDirection;
            } else {
                sortDirection = type === 'string';
            }
            currentSortColumn = columnIndex;
            rows.sort((a, b) => {
                const aVal = a.children[columnIndex].getAttribute('data-sort');
                const bVal = b.children[columnIndex].getAttribute('data-sort');
                if (type === 'date') {
                    return sortDirection
                        ? new Date(aVal).getTime() - new Date(bVal).getTime()
                        : new Date(bVal).getTime() - new Date(aVal).getTime();
                }
                return sortDirection ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
            });
            container.innerHTML = "";
            rows.forEach(row => container.appendChild(row));
        }
    </script>
</head>
<body>

<!-- ── Top Navigation ── -->
<nav class="topnav">
    <a href="/" class="nav-brand">
        <img src="01384a5a5e3c1ea5887b428641e12121.gif" alt="" style="width:18px; height:auto;">
        ACPTDA
    </a>
    <div class="nav-right">
        @if (ViewBag.Username != null)
        {
            <span class="nav-user">
                Hello, <span class="username">@ViewBag.Username</span>
            </span>
        }
        <button id="signoutbutton" class="signout-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Sign Out
        </button>
    </div>
</nav>

<!-- ── Main Content ── -->
<main class="main-content">

    <!-- Page header -->
    <header class="page-header">
        <div class="page-header-text">
            <h2>Your Workspaces</h2>
            <p>Select a file to open the workspace, or upload a new CSV to begin analysis.</p>
        </div>
        <form method="post" enctype="multipart/form-data" id="uploadForm">
            <input type="file" name="file" accept=".csv" id="fileInput"
                   style="display:none;" onchange="upload()">
        </form>
        <button class="upload-btn" onclick="document.getElementById('fileInput').click()">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            Upload CSV
        </button>
    </header>

    <!-- File table -->
    <div class="file-table-wrap">
        <!-- Column headers -->
        <div class="table-header">
            <div class="th-name" onclick="sortTable(0,'string')">
                Name
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 15l5 5 5-5"/><path d="M7 9l5-5 5 5"/></svg>
            </div>
            <div class="th-date" onclick="sortTable(1,'date')">
                Edited
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 15l5 5 5-5"/><path d="M7 9l5-5 5 5"/></svg>
            </div>
        </div>

        <!-- File rows -->
        <div id="fileListContainer">
            @{
                int id = 0;
                foreach (var file in Model)
                {
                    string containerId = "fileCard_" + id;
                    <div id="@containerId" class="file-row" data-token="@file.PublicToken" onclick="select('@file.Name')">
                        <div class="file-main" data-sort="@file.Name">
                            <div class="file-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                    <polyline points="10 9 9 9 8 9"/>
                                </svg>
                            </div>
                            <div class="file-info">
                                <div class="file-name-row">
                                    <span class="filename-text">@file.Name</span>
                                    <!-- Dropdown -->
                                    <div class="file-actions" onclick="event.stopPropagation()">
                                        <button class="actions-btn" onclick="toggleDropdown(this, event)" title="More actions">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
                                            </svg>
                                        </button>
                                        <div class="dropdown-menu hidden">
                                            <button class="dropdown-item"
                                                    onclick="toggleDropdown(this.closest('.file-actions').querySelector('button'), event); renameAction('@containerId', event)">
                                                Rename
                                            </button>
                                            <button class="dropdown-item danger"
                                                    onclick="removeFile('@file.Name', '@containerId', event)">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <span class="file-meta">Created @file.CreatedTime.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                        <div class="file-date" data-sort="@file.ModifiedTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                            @file.ModifiedTime.ToString("MMM dd, yyyy")
                        </div>
                        @if (file.Status == LQ.Models.TableModels.UploadStatus.Processing)
                        {
                            <div class="file-loading-bar" aria-label="Processing"></div>
                        }
                    </div>
                    id++;
                }

                if (Model.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="12" y1="18" x2="12" y2="12"/>
                                <line x1="9" y1="15" x2="15" y2="15"/>
                            </svg>
                        </div>
                        <h3>No workspaces yet</h3>
                        <p>Upload a CSV file to create your first workspace</p>
                    </div>
                }
            }
        </div>
    </div>
</main>

<!-- ── Global Loader Overlay ── -->
<div id="global-loader">
    <div class="loader">
        <div class="loader__bar"></div>
        <div class="loader__bar"></div>
        <div class="loader__bar"></div>
        <div class="loader__bar"></div>
        <div class="loader__bar"></div>
        <div class="loader__ball"></div>
    </div>
    <p class="loader-text">Preparing Workspace&hellip;</p>
</div>

</body>
</html>
