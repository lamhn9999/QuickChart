@model List<LQ.Models.TableModels.CSVFile>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>Automatic CSV Plotting Tool for Data Analysts</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="01384a5a5e3c1ea5887b428641e12121.gif" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Playfair Display', serif; }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const signOutBtn = document.getElementById("signoutbutton");
            if(signOutBtn) signOutBtn.addEventListener("click", signOut);
            document.addEventListener("click", () => {
                document.querySelectorAll('.dropdown-menu').forEach(el => el.classList.add('hidden'));
            });
            sortTable(1, 'date', false);
        });

        function toggleDropdown(btn, event) {
            event.stopPropagation();
            const dropdown = btn.nextElementSibling;
            const isHidden = dropdown.classList.contains('hidden');
            document.querySelectorAll('.dropdown-menu').forEach(el => el.classList.add('hidden'));
            if (isHidden) {
                dropdown.classList.remove('hidden');
            }
        }

        async function removeFile(filename, containerId, event) {
            event.stopPropagation();
            if(!confirm(`Are you sure you want to delete ${filename}?`)) return;
            const response = await fetch("@Url.Action("Remove", "Home")", {
                method: "DELETE",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `filename=${encodeURIComponent(filename)}`
            });
            const result = await response.json();
            if(result === "OK") {
                document.getElementById(containerId).remove();
            }
        }

        function renameAction(containerId, event) {
            event.stopPropagation();
            const element = document.getElementById(containerId);
            const fileText = element.querySelector(".filename-text");
            const oldName = fileText.textContent;
            
            const input = document.createElement("input");
            input.type = "text";
            input.value = oldName;
            input.className = "filename-input bg-zinc-800 text-white px-2 py-1 rounded outline-none border border-[#E9967A] flex-1";
            input.onclick = (e) => e.stopPropagation();

            fileText.replaceWith(input);
            input.focus();
            input.select();

            let isRenaming = false;

            input.addEventListener("keydown", function (e) {
                if (e.key === "Enter") finishRename();
                if (e.key === "Escape") cancelRename();
            });

            input.addEventListener("blur", finishRename);

            function cancelRename() {
                if (isRenaming) return;
                isRenaming = true;
                input.replaceWith(fileText);
            }

            function finishRename() {
                if (isRenaming) return;
                isRenaming = true;
                const newName = input.value.trim();
                
                input.replaceWith(fileText);

                if (!newName || newName === oldName) return;

                rename(oldName, newName, containerId);
            }
        }

        async function rename(filename, newfilename, containerId) {
            const response = await fetch("@Url.Action("RenameFile","Home")", {
                method: "PUT",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `oldfilename=${encodeURIComponent(filename)}&newfilename=${encodeURIComponent(newfilename)}`
            });
            const result = await response.json();
            if (result === "OK") {
                location.reload(); // Reload to refresh everything correctly
            }
        }
        
        async function upload() {
            const form = document.getElementById('uploadForm');
            const formData = new FormData(form);
            const response = await fetch("@Url.Action("Upload", "Home")", {
                method : form.method || 'POST',
                body: formData
            });
            await response.json();
            document.getElementById('fileInput').value = "";
            location.reload();
        }

        async function select(filename) {
            const loader = document.getElementById('global-loader');
            loader.classList.remove('hidden');
            
            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `filename=${encodeURIComponent(filename)}`
            });
            
            if (response.ok) {
                window.location.href = '/workspace';
                // loader.classList.add('hidden')
            } else {
                loader.classList.add('hidden');
                alert("Failed to load workspace.");
            }
        }

        async function signOut() {
            const response = await fetch("@Url.Action("SignOut","Auth")", { method: "POST" });
            const result = await response.json();
            if (result.redirect) {
                window.location.href = result.redirect;
            }
        }

        let currentSortColumn = -1;
        let sortDirection = false;
        function sortTable(columnIndex, type, forceDirection = null) {
            const container = document.getElementById("fileListContainer");
            if (!container) return;
            const rows = Array.from(container.querySelectorAll(".file-row"));
            if (rows.length === 0) return;

            if (forceDirection !== null) {
                sortDirection = forceDirection;
            } else if (currentSortColumn === columnIndex) {
                sortDirection = !sortDirection;
            } else {
                sortDirection = type === 'string' ? true : false;
            }
            currentSortColumn = columnIndex;

            rows.sort((a, b) => {
                const aColText = a.children[columnIndex].getAttribute('data-sort');
                const bColText = b.children[columnIndex].getAttribute('data-sort');
                if (type === 'date') {
                    return sortDirection 
                        ? new Date(aColText).getTime() - new Date(bColText).getTime()
                        : new Date(bColText).getTime() - new Date(aColText).getTime();
                } else {
                    return sortDirection
                        ? aColText.localeCompare(bColText)
                        : bColText.localeCompare(aColText);
                }
            });
            container.innerHTML = "";
            rows.forEach(row => container.appendChild(row));
        }
    </script>
</head>
<body class="bg-zinc-950 text-slate-200 min-h-screen flex flex-col">

<nav class="bg-zinc-900 border-b border-zinc-800 px-6 py-4 flex justify-between items-center sticky top-0">
    <div class="flex items-center gap-3">
        <span>
            <img src = "01384a5a5e3c1ea5887b428641e12121.gif" alt="cunghyphattai" class="w-5 h-auto scale-x-[-1]">
            </span>
        <h1 class="text-xl font-semibold tracking-tight text-white">Automatic CSV Plotting Tool for <span class="text-[#E9967A]">Data Analysts</span></h1>
    </div>
    <div class="flex items-center gap-4">
        @if (ViewBag.Username != null)
        {
            <span class="text-zinc-300 text-sm font-medium pr-2 border-r border-zinc-700">Hello, <span class="text-[#E9967A]">@ViewBag.Username</span></span>
        }
        <button id="signoutbutton" class="hover:cursor-pointer text-sm font-medium text-zinc-400 hover:text-white transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            Sign Out
        </button>
    </div>
</nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-8 flex flex-col gap-6">
        
        <header class="flex justify-between items-end pb-4 border-b border-zinc-800">
            <div>
                <h2 class="text-3xl font-bold text-white mb-2">Your Workspaces</h2>
                <p class="text-zinc-400 text-sm">Select a file below to enter the workspace, or upload a new CSV file to begin analysis.</p>
            </div>
            <form method="post" enctype="multipart/form-data" id="uploadForm">
                <input type="file" name="file" accept=".csv" id="fileInput" style="display:none;" onchange="upload()">
            </form>
            <button onclick="document.getElementById('fileInput').click()" class="hover:cursor-pointer bg-[darksalmon] hover:bg-[#E9967A] text-white text-shadow-2xs  px-5 py-2.5 rounded-lg flex items-center gap-2 text-sm font-semibold transition-all active:scale-95">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                Upload a CSV
            </button>
        </header>

        <div class="mt-4 border border-zinc-800 rounded-xl bg-zinc-900 overflow-hidden">
            <!-- Table Header -->
            <div class="flex items-center bg-zinc-800 border-b border-zinc-700 text-sm font-semibold text-zinc-300">
                <div class="flex-1 p-4 cursor-pointer hover:bg-zinc-700 transition-colors select-none" onclick="sortTable(0, 'string')">Name ↕</div>
                <div class="w-36 p-4 cursor-pointer hover:bg-zinc-700 transition-colors select-none" onclick="sortTable(1, 'date')">Edited ↕</div>
            </div>

            <!-- Table Body -->
            <div id="fileListContainer" class="flex flex-col">
                @{
                    int id = 0;
                    foreach (var file in Model)
                    {
                        string containerId = "fileCard_" + id;
                        <div id="@containerId" class="file-row flex items-center border-b border-zinc-800/50 hover:bg-zinc-800/50 transition-colors group cursor-pointer" onclick="select('@file.Name')">
                            <div class="flex-1 p-4 flex items-center gap-3" data-sort="@file.Name">
                                <div class="p-2 bg-zinc-800 rounded-md text-white">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="filename-text font-medium text-zinc-100">@file.Name</span>
                                        <div class="relative inline-block text-left" onclick="event.stopPropagation()">
                                            <button onclick="toggleDropdown(this, event)" class="p-1.5 text-zinc-500 hover:text-white hover:bg-zinc-700 rounded-md transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path></svg>
                                            </button>
                                            <div class="dropdown-menu absolute z-50 left-0 top-full mt-1 w-36 rounded-lg border border-zinc-700 bg-zinc-800 hidden overflow-hidden z-20 shadow-xl">
                                                <button class="w-full text-left px-4 py-2 text-sm text-zinc-300 hover:bg-zinc-700 hover:text-white"
                                                        onclick="toggleDropdown(this, event); renameAction('@containerId', event)">
                                                    Rename
                                                </button>
                                                <button class="w-full text-left px-4 py-2 text-sm text-red-500 hover:bg-red-500/10"
                                                        onclick="removeFile('@file.Name', '@containerId', event)">
                                                    Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <span class="text-zinc-500 text-xs mt-0.5">Created: @file.CreatedTime.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            <div class="w-36 p-4 text-zinc-400 text-sm" data-sort="@file.ModifiedTime.ToString("yyyy-MM-ddTHH:mm:ss")">@file.ModifiedTime.ToString("MMM dd, yyyy")</div>
                        </div>
                        id++;
                    }

                    if (Model.Count == 0)
                    {
                        <div class="p-16 flex flex-col items-center justify-center text-center w-full">
                            <div class="w-16 h-16 rounded-full bg-zinc-800 flex items-center justify-center text-zinc-600 mb-4">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <p class="text-zinc-300 font-medium text-lg">No workspaces found</p>
                            <p class="text-zinc-500 text-sm mt-1">Upload a CSV file to get started</p>
                        </div>
                    }
                }
            </div>
        </div>
    </main>

    <div id="global-loader" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50 hidden flex flex-col items-center justify-center">
            <div class="loader">
                <div class="loader__bar"></div>
                <div class="loader__bar"></div>
                <div class="loader__bar"></div>
                <div class="loader__bar"></div>
                <div class="loader__bar"></div>
                <div class="loader__ball"></div>
            </div>
        <p class="mt-6 text-[#E9967A] font-medium tracking-widest text-sm animate-pulse">PREPARING WORKSPACE...</p>
    </div>

</body>
</html>