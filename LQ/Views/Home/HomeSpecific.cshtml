@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document
                .getElementById("signoutbutton")
                .addEventListener("click", signOut);
            document
                .getElementById("workspaceButton")
                .addEventListener("click", enterWorkspace);
            
            document.addEventListener("click", () => {
                document.querySelectorAll('.dropdown-menu').forEach(el => el.classList.add('hidden'));
            });
        });

        function toggleDropdown(btn, event) {
            event.stopPropagation();
            const dropdown = btn.nextElementSibling;
            const isHidden = dropdown.classList.contains('hidden');
            
            document.querySelectorAll('.dropdown-menu').forEach(el => el.classList.add('hidden'));
            
            if (isHidden) {
                dropdown.classList.remove('hidden');
            }
        }

        async function remove(filename, listgodid) {
            const response = await fetch("@Url.Action("Remove", "Home")", {
                method: "DELETE",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `filename=${encodeURIComponent(filename)}`
            })
            const result = await response.json();
            if(result === "OK")
            {
                console.log(listgodid);
                document.getElementById(listgodid).remove();
            }
        }

        function renameaction(listelementid, listgodid) {
            const element = document.getElementById(listgodid);
            const fileDiv = element.querySelector(".listfile");

            const oldName = fileDiv.textContent;

            const input = document.createElement("input");
            input.type = "text";
            input.value = oldName;
            input.className = "listfile w-full bg-transparent outline-none";

            fileDiv.replaceWith(input);
            input.focus();
            input.select();

            let isRenaming = false;

            input.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    finishRename();
                }
            });

            input.addEventListener("blur", finishRename);

            function finishRename() {
                if (isRenaming) return;
                isRenaming = true;
                const newName = input.value.trim();
                
                input.replaceWith(fileDiv);

                if (!newName || newName === oldName) {
                    return;
                }

                rename(oldName, newName, listgodid);
            }
        }

        async function rename(filename, newfilename, listgodid) {
            console.log(filename, newfilename);
            const response = await fetch("@Url.Action("RenameFile","Home")", {
                method: "PUT",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `oldfilename=${encodeURIComponent(filename)}&newfilename=${encodeURIComponent(newfilename)}`
            });

            const result = await response.json();

            if (result === "OK") {
                const wrapper = document.getElementById(listgodid);
                const fileDiv = wrapper.getElementsByClassName("listfile")[0];

                fileDiv.textContent = newfilename;

                const listelement = wrapper.querySelector('.listelement');
                if (listelement) listelement.setAttribute('onclick', `select('${newfilename}')`);

                const removeBtn = wrapper.querySelector('button.text-red-600');
                if (removeBtn) removeBtn.setAttribute('onclick', `remove('${newfilename}', '${listgodid}')`);
            }
        }
        
        async function upload() {
            const form = document.getElementById('uploadForm');
            const formData = new FormData(form);
            const response = await fetch("@Url.Action("Upload", "Home")", {
                method : form.method || 'POST',
                body: formData
            });
            const result = await response.json();
            console.log(result);
            document.getElementById('fileInput').value = "";
            location.reload();
        }
        async function select(filename) {
            document.getElementById("previewFilename").textContent = " - " + filename;
            document.getElementById("dataTable").hidden = true;
            document.getElementById("loader").hidden = false;
            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.display = "none";

            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `filename=${encodeURIComponent(filename)}`
            });

            const data = await response.json();
            document.getElementById("loader").hidden = true;
            const table = document.getElementById("dataTable");
            table.hidden = false;
            table.innerHTML = "";
            table.setAttribute("border", "1");

            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.removeProperty('display');

            for (let i = 0; i < data.length && i <= 200; i++) {
                const row = data[i];

                const tr = (i === 0)
                    ? document.createElement("thead")
                    : document.createElement("tr");

                if (i === 0) {
                    tr.classList.add("sticky", "top-0", "z-10", "bg-white");
                }

                row.forEach(cell => {
                    const el = document.createElement(i === 0 ? "th" : "td");
                    el.textContent = cell;
                    tr.appendChild(el);
                });

                table.appendChild(tr);
            }
        }
        async function signOut() {
            const response = await fetch("@Url.Action("SignOut","Auth")", {
                method: "POST"
            });
            const result = await response.json();
            if (result.redirect)
            {
                window.location.href = result.redirect;
            }
        }
        function enterWorkspace()
        {
            window.location.href = '/workspace';
        }
    </script>
</head>
<body class="bg-zinc-800 text-white">
<div class="flex h-screen">
    <div class="flex flex-col h-screen w-1/7 max-w-1/7 min-w-0 bg-zinc-900 p-5">
        
        <div class="listelement text-xl font-bold" id="doc">
            <button>Documentation</button>
        </div>
        <div class="mb-5 max-w-full min-w-0">
            <p class="text-xl font-bold">Your files</p>
            <div class="text-xl min-w-0">
                @{
                    int id = 0;
                    foreach (string file in Model)
                    {
                        string listgodid = "listgod" + id;
                        string listelementid = "listelement" + id;
                        <div class="flex justify-between" id = @listgodid>
                            <div class="listelement min-w-0 flex-1" id=@listelementid onclick="select('@file')">
                                <div class="listline"></div>
                                <div class="listfile overflow-hidden text-ellipsis">@file</div>
                            </div>
                            
                            <div class="relative flex">
                                <button
                                    onclick="toggleDropdown(this, event)"
                                    class="rounded-md w-5 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:cursor-pointer"
                                >
                                    ...
                                </button>
                                <div class="dropdown-menu absolute top-full mt-1 w-44 rounded-md border bg-zinc-700 z-[60] hidden">
                                    <button class="flex w-full items-center gap-2 px-4 py-2 text-sm hover:bg-zinc-100 dark:hover:bg-zinc-800"
                                            onclick="this.closest('.relative').querySelector('.absolute').classList.add('hidden'); renameaction('@listelementid','@listgodid')">
                                        Rename
                                    </button>

                                    <button class="flex w-full items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30"
                                            onclick="remove('@file', '@listgodid')">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                        id++;
                    }
                }
            </div>
        </div>
        
        <div class="text-xl">
            <p class="font-bold">Upload here
                <span>
                    <button class="addbutton" style = "color: darksalmon; border-color: darksalmon;" onclick="document.getElementById('fileInput').click()"></button>
                    <form method = "post" 
                          enctype="multipart/form-data"
                          id="uploadForm">
                        <input type="file"
                               name="file"
                               accept=".csv"
                               id="fileInput"
                               style="display:none;"
                               onchange="upload()"></form>
                </span>
            </p>
        </div>
        
        <div class = "flex flex-col text-xl font-extrabold">
            <p>Sign out?</p>
            <button class="signoutbutton" id="signoutbutton">HAPPY NEW YEAR</button>
        </div>
        
        <div class="flex flex-1"></div>
        
    </div>
    <div class="flex flex-1 flex-col h-screen p-5 min-w-0">
        <header class=" text-4xl mb-5 text-center font-extrabold">
            <p>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</p>
        </header>
        <div class="flex flex-col flex-1 text-4xl min-h-0">
            <div class="flex font-bold justify-between">
                <p class="italic">Preview<span id="previewFilename" style="color: darksalmon;"></span></p>
                <button class="signinbutton font-extrabold" id="workspaceButton" style="display: none">Enter Workspace /></button>
            </div>
            <div class="min-w-0 min-h-0 overflow-auto border-solid border-gray-500 border-2 flex-1 content-center align-middle">
                <table class="text-lg border-separate border-spacing-0 bg-zinc-950" id="dataTable" hidden></table>
                <div id="noPreview" class="text-center">
                    <p class="text-gray-500 font-bold">No preview available</p>
                </div>
                <div hidden class="flex-1 content-center" id="loader">
                    <div class="loader">
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__bar"></div>
                        <div class="loader__ball"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="
          hidden md:flex h-screen shrink-0
          w-1/7
          min-w-[200px] max-w-[320px]
          bg-zinc-900
        ">
        <div class="relative flex flex-1 overflow-hidden">
    
            <!-- Background image -->
            <div
                class="absolute inset-0 bg-cover bg-center scale-105"
                style="background-image: url('/Screenshot_20260207_112111.png');"
            ></div>

            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-l from-black/70 via-black/40 to-transparent"></div>

            <!-- Optional content -->
            <div class="relative z-10 flex flex-1 items-end p-6">
                <span class="text-lg font-extrabold tracking-wide text-zinc-200 uppercase">
                    恭喜发财
                </span>
            </div>
        </div>
    </div>
</div>
</body>
</html>