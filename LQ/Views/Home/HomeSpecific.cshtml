@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style_tw.css"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document
                .getElementById("signoutbutton")
                .addEventListener("click", signOut);
            document
                .getElementById("workspaceButton")
                .addEventListener("click", enterWorkspace);
        });
        async function upload() {
            const form = document.getElementById('uploadForm');
            const formData = new FormData(form);
            const response = await fetch("@Url.Action("Upload", "Home")", {
                method : form.method || 'POST',
                body: formData
            });
            const result = await response.json();
            console.log(result);
            document.getElementById('fileInput').value = "";
            location.reload();
        }
        async function select(filename) {
            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `filename=${encodeURIComponent(filename)}`
            });

            const data = await response.json();
            const table = document.getElementById("dataTable");
            table.hidden = false;
            table.innerHTML = "";
            table.setAttribute("border", "1");

            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.removeProperty('display');

            for (let i = 0; i < data.length && i <= 200; i++) {
                const row = data[i];

                const tr = (i === 0)
                    ? document.createElement("thead")
                    : document.createElement("tr");

                row.forEach(cell => {
                    const el = document.createElement(i === 0 ? "th" : "td");
                    el.textContent = cell;
                    tr.appendChild(el);
                });

                table.appendChild(tr);
            }
        }
        async function signOut() {
            const response = await fetch("@Url.Action("SignOut","Auth")", {
                method: "POST"
            });
            const result = await response.json();
            if (result.redirect)
            {
                window.location.href = result.redirect;
            }
        }
        function enterWorkspace()
        {
            window.location.href = '/workspace';
        }
    </script>
</head>
<body class="bg-zinc-800 text-white p-5">
<div class="flex flex-col h-screen">
<header class="glossy text-5xl mb-5 text-center">
    <p>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</p>
</header>
<div class="flex sm:flex-col md:flex-row flex-1">
    <div class="md:w-1/2 sm:w-full">
        <div class="text-4xl">
            <p class="font-bold">At your convenience, please select the CSV you would like to proceed with.</p>
            <div class="mb-5">
                @{
                    int id = 0;
                    foreach (string file in Model)
                    {
                        <div class="listelement ml-10" id="listelement@id" onclick="select('@file');">
                            <div class="listline"></div>
                            <div class="listfile">@file</div>
                        </div>
                        id++;
                    }
                }
            </div>
            <div class="flex">
                <p class="font-bold">You could upload a CSV. Gently click the round orange button
                    <span>
                        <button class="addbutton" style = "color: darksalmon; border-color: darksalmon;" onclick="document.getElementById('fileInput').click()"></button>
                        <form method = "post" 
                              enctype="multipart/form-data"
                              id="uploadForm">
                            <input type="file"
                                   name="file"
                                   accept=".csv"
                                   id="fileInput"
                                   style="display:none;"
                                   onchange="upload()"></form>
                    </span>
                </p>
            </div>
            <p class="font-bold">Has the job been finalized?</p>
            <button class="signoutbutton font-extrabold" id = "signoutbutton">HAPPY NEW YEAR</button>
        </div>
    </div>
    <div class="flex flex-col flex-1 text-4xl md:w-1/2 sm:w-full max-h-200">
        <div class="flex font-bold justify-between">
            <p class="italic">Preview</p>
            <button class="signinbutton font-extrabold" id="workspaceButton" style="display: none">Enter Workspace /></button>
        </div>
        <div class="overflow-auto border-solid border-gray-500 border-2 flex-1 content-center align-middle">
            <table class="text-lg" id="dataTable" hidden></table>
            <div id="noPreview" class="text-center">
                <p class="text-gray-500 font-bold">No preview available</p>
            </div>
        </div>
    </div>
</div>
</div>
</body>
</html>