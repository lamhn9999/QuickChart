@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style.css"/>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document
                .getElementById("signoutbutton")
                .addEventListener("click", signOut);
            document
                .getElementById("workspaceButton")
                .addEventListener("click", enterWorkspace);
        });
        async function upload() {
            const form = document.getElementById('uploadForm');
            const formData = new FormData(form);
            const response = await fetch("@Url.Action("Upload", "Home")", {
                method : form.method || 'POST',
                body: formData
            });
            const result = await response.json();
            console.log(result);
            document.getElementById('fileInput').value = "";
            location.reload();
        }
        async function select(filename) {
            const response = await fetch("@Url.Action("Select","Home")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `filename=${encodeURIComponent(filename)}`
            });

            const data = await response.json();
            const table = document.getElementById("dataTable");
            table.hidden = false;
            table.innerHTML = "";
            table.setAttribute("border", "1");

            document.getElementById("noPreview").style.display = "none";
            document.getElementById("workspaceButton").style.removeProperty('display');

            data.forEach((row, i) => {
                const tr = document.createElement("tr");
                row.forEach(cell => {
                    const el = document.createElement(i === 0 ? "th" : "td");
                    el.textContent = cell;
                    tr.appendChild(el);
                });
                table.appendChild(tr);
            });
        }
        async function signOut() {
            const response = await fetch("@Url.Action("SignOut","Auth")", {
                method: "POST"
            });
            const result = await response.json();
            if (result.redirect)
            {
                window.location.href = result.redirect;
            }
        }
        function enterWorkspace()
        {
            window.location.href = '/workspace';
        }
    </script>
</head>
<body>
<div style = "display: flex; gap: var(--main-div-gap);">
    <div style="width: 50vw">
        <header style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <div style="display:flex; gap:0; flex-direction:column; justify-content:center; align-items: center">
                <h1 class="glossy">THE WORLD'S NO.1 AUTOMATIC CSV PLOTTING TOOL FOR DATA ANALYSTS!</h1>
            </div>
        </header>
        <h2 class="listlabel">At your convenience, please select the CSV you would like to proceed with.</h2>
        <div>
            @foreach (string file in Model)
            {
                <div class="listelement" onclick="select('@file')">
                    <div class="listline"></div>
                    <div class="listfile">@file</div>
                </div>
            }
        </div>
        <div style="display:flex; align-items:center; gap: var(--main-div-gap);">
            <h2>You could upload a CSV. Gently click the round orange button
                <span>
                    <button class="addbutton" style = "color: darksalmon; border-color: darksalmon;" onclick="document.getElementById('fileInput').click()"></button>
                    <form method = "post" 
                          enctype="multipart/form-data"
                          id="uploadForm">
                        <input type="file"
                               name="file"
                               accept=".csv"
                               id="fileInput"
                               style="display:none;"
                               onchange="upload()"></form>
                </span></h2>
        </div>
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h2>Has the job been finalized?</h2>
        </div>
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start;">
            <button class="signoutbutton" id = "signoutbutton">WE WISH YOU A MERRY CHRISTMAS</button>
        </div>
    </div>
    <div style="width: 50vw; height: 90vh;">
        <div style="display: flex; justify-content: space-between;">
            <h2 style="font-style: italic">Preview</h2>
            <button class="signinbutton" id="workspaceButton" style="display: none">Enter Workspace /></button>
        </div>
        <div style="max-height: 85vh; overflow: auto">
            <table id="dataTable" hidden></table>
            <div id="noPreview" style="border: 1px solid white; display: flex; justify-content: center; align-items: center; height: calc(85vh - 2px);">
                <h3 style="color: darkgrey">No preview available.</h3>
            </div>
        </div>
    </div>
</div>
</body>
</html>