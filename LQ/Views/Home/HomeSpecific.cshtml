@using Microsoft.AspNetCore.Mvc.Routing
@model List<string>;
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>LQ</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/style.css"/>
    <script>
        async function upload() {
            const form = document.getElementById('uploadForm');
            const formData = new FormData(form);
            const response = await fetch("@Url.Action("Upload", "Home")", {
                method : form.method || 'POST',
                body: formData
            });
            const result = await response.json();
            console.log(result);
            document.getElementById('fileInput').value = "";
        }
        async function signOut() {
            const response = await fetch("@Url.Action("SignOut","Auth")", {
                method: "POST"
            });
            const result = await response.json();
            if (result.redirect)
            {
                window.location.href = result.redirect;
            }
        }
    </script>
</head>
<body>
<div style = "display: flex; gap: var(--main-div-gap);">
    <div style="width: 50vw">
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h1 class = "glossy">LQ</h1>
            <p style="width: 0; font-size: var(--main-div-gap)">Automatic CSV Plotter.</p>
        </div>
        <h2 class="listlabel">Select a CSV</h2>
        <div>
            @foreach (string file in Model)
            {
                <div class="listelement">
                    <div class="listline"></div>
                    <div class="listfile">@file</div>
                </div>
            }
        </div>
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <h2>or</h2>
        </div>
        <div style="display:flex; align-items:center; gap: var(--main-div-gap);">
            <h2>Upload a CSV</h2>
            <button class="addbutton" style = "color: darksalmon; border-color: darksalmon;" onclick="document.getElementById('fileInput').click()"></button>
            <form method = "post" 
                  enctype="multipart/form-data"
                  id="uploadForm">
            <input type="file"
                   name="file"
                   accept=".csv"
                   id="fileInput"
                   style="display:none;"
                   onchange="upload()"></form>
        </div>
        <div style="display: flex; gap: var(--main-div-gap); justify-content: flex-start; align-items: center">
            <button class="signoutbutton" onclick="signOut()">Sign Out</button>
        </div>
    </div>
</div>
</body>
</html>